// VRealms identifies itself so the engine can boot without a Doom IWAD.
//
// It contains no game content. Realms of the Haunting is read from the
// player's own installation at run time; this package only tells the engine
// what game it is running and where to begin.
IWad
{
	Name = "VRealms -- Realms of the Haunting"
	Autoname = "vrealms"
	Game = "Doom"
	Config = "VRealms"
	IWADName = "vrealms.pk3"
	Mapinfo = "mapinfo/vrealms.txt"
	MustContain = "VREALMS"
	BannerColors = "0b 0b 14", "c8 b8 90"
}
