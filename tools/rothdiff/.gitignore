# Outputs, not sources. A stale capture silently compared against new code is
# exactly the trap this tool exists to remove, so they are never committed.
captures/
*.ridb
baseline.json

# Build products.
*.exe
*.dll
__pycache__/

# Savegames are GAME-DERIVED DATA and never go in the repo -- the same rule
# that keeps the retail install read-only. They are made once per map by hand
# (see warp_and_save.bat) and live here only so run_rothdiff can swap them
# into slot 0 without destroying each other.
saves/
