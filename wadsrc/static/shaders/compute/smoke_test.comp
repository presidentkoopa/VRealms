// [SMOKEVOLUME] 13a: the smoke volume's minimal compute step ("Engine docs/
// SMOKE_VOLUME_PLAN.md" 13a; r_smoke_computetest). It proves the compute path end to
// end -- a 3D volume read as a filtered sampler3D, the other image of its ping-pong
// pair written as a storage image, push constants, the 8 x 8 x 8 dispatch -- with a
// visible-to-13c test pattern: a soft blob orbiting the grid centre, its trail decaying
// and rising. Nothing draws it yet.
//
// VkComputeManager::CreateProgram prepends "#version 450", the include extension and
// "#line 1". Push constants: SmokeTestConstants in vk_smokevolume.cpp (48 bytes).
//
// GLSL reserved-word rule (NVIDIA GL): no identifier here is a reserved word.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(set = 0, binding = 0) uniform sampler3D DensityPrevious;
layout(set = 0, binding = 1, rg16f) uniform writeonly image3D DensityNext;

layout(push_constant) uniform SmokeTestConstants
{
	ivec3 GridSize;		// cells per axis
	float StepTime;		// the step's maptime, tics
	vec3 BlobCenter;	// cells
	float BlobRadius;	// cells
	float Decay;		// the previous state's multiplier per step
	float Rise;			// cells per step the previous state moves up
	float Amount;		// density added at the blob's centre per step
	float HeatAmount;	// heat added at the blob's centre per step
};

void main()
{
	ivec3 cell = ivec3(gl_GlobalInvocationID);
	if (any(greaterThanEqual(cell, GridSize)))
		return;

	vec3 gridSize = vec3(GridSize);
	vec3 cellCenter = vec3(cell) + vec3(0.5);

	// The previous state one Rise below this cell (smoke drifts up), decayed.
	vec3 uvw = (cellCenter - vec3(0.0, 0.0, Rise)) / gridSize;
	vec2 previous = textureLod(DensityPrevious, uvw, 0.0).rg * Decay;

	float d = length(cellCenter - BlobCenter) / max(BlobRadius, 0.001);
	float blob = clamp(1.0 - d, 0.0, 1.0);
	blob *= blob;

	imageStore(DensityNext, cell, vec4(previous.r + blob * Amount, previous.g + blob * HeatAmount, 0.0, 0.0));
}
