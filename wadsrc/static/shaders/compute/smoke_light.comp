// [SMOKEVOLUME] 13d: the smoke's light grid ("Engine docs/SMOKE_VOLUME_PLAN.md" 13d, owner answer 4:
// a FINE light grid, the method shipping volumetric fog uses).
//
// Every light at every march sample would be about a billion light evaluations an eye a frame. Instead
// the light is worked out once a frame on a world-aligned grid over the smoke box (hw_framecompute.h,
// SmokeLightGridSpec), and shaders/pp/smokemarch.fp samples it. Both eyes read the same grid.
//
// Two volumes, written in place:
//   LightGrid       rgb the light reaching the cell; a its luminance weight (every contribution's)
//   LightDirection  xyz the direction light TRAVELS through the cell, averaged by weight -- its length
//                   is the share of the light that comes from that direction (0 = from all round)
//
// One lump, two passes (RegionMin.w):
//   0 AMBIENT, over EVERY cell of the grid, first: the cell's column's sector light (AmbientColumns, from
//     the CPU) times the look's ambient; no direction. This replaces last frame's light everywhere, so no
//     cell ever shows an earlier frame's light -- not even at the faint edge of fading smoke, where the
//     previous simulation state can still hold a trace of density in a tile that has gone quiet.
//   1 ONE LIGHT, over only the cells its sphere's box covers, and only in ACTIVE tiles (TileActive 1):
//     attenuation 1 - d / r as surfaces take it, the spot cone as main.fp's spotLightAttenuation, and --
//     when the engine's shadow map is live this frame and the light has a row in it -- occlusion by walls,
//     as surfaces get it. The colour adds to rgb; the direction is averaged again with this light's weight.
//     Skipping quiet tiles keeps a light's cost to the smoke it touches: every light cell the trilinear
//     footprint of a sample near smoke reaches lies in an active tile (the tile map is spread by a tile;
//     "Engine docs/SMOKE_13D_IMPL_NOTES.md", mirror L10), so only a trace of density far below visible can
//     miss a light, and then it keeps its ambient light, never an old one.
//
// [13e] SOOT DARKNESS. Soot is darkness-weighted density in the velocity image's w (smoke_inject.comp,
// smoke_advect.comp). While soot may be in the volume (pass 0's Color.w), pass 0 works out each cell's
// darkness -- soot / density at the cell's centre, 0..1 -- darkens the ambient light by it and keeps it in
// LightDirection.w; pass 1 darkens each light by the w kept there and keeps w. So sooty smoke sends back
// less of every light while it hides what is behind it exactly as before (extinction is not touched), and
// smokemarch.fp needs nothing new. The luminance weights are not darkened: a cell's darkness is the same
// for all its light, so the direction shares stay as they were. Without soot every value here is 13d's
// exactly: darkness 0, and w stays 0.
//
// [EFFECTLIGHTS] LD: PASS 2, THE EFFECT LIGHTS (sparks, embers, impacts, tracers) -- only in the SMOKE_EFFECT_LIGHTS
// variant (EffectLightPass below): one dispatch over the cells effect lights can reach, each cell looping its own
// effect-light bin. Without that define this lump is, token for token, the program passes 0 and 1 always were.
//
// [13F] SURFACE LIGHT IN PASS 0 -- only in the SMOKE_SURFACE_LIGHT variant (SurfaceAmbient below), which the CPU asks for only
// on frames a column's sector glows, a sweep band gives light, the darkness curve is on or a passed look is live: the column's
// sector light through main.fp's darkness curve and passed look, plus its glow lanes and the bands' light. Every other frame
// runs pass 0 through the program without the define, which is HEAD's.
//
// Axes: Doom's (x, y horizontal, z up), map units from the grid's minimum corner. Light cell c spans
// [c, c + 1) x Cone.z map units; its centre is where the light is taken.
//
// VkComputeManager::CreateProgram prepends "#version 450", the include extension and "#line 1".
// Push constants: SmokeLightConstants in vk_smokevolume.cpp (96 bytes).
// GLSL reserved-word rule (NVIDIA GL): no identifier here is a reserved word.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(set = 0, binding = 0) uniform sampler3D TileActive;		// one texel per smoke tile, 1 = may hold smoke
layout(set = 0, binding = 1) uniform sampler2D AmbientColumns;	// one texel per light-grid column, rgb its sector light
layout(set = 0, binding = 2) uniform sampler2D ShadowMap;		// the engine's shadow map (hw_shadowmap.cpp, shadowmap.fp)
layout(set = 0, binding = 3, rgba16f) uniform image3D LightGrid;
layout(set = 0, binding = 4, rgba8_snorm) uniform image3D LightDirection;
layout(set = 0, binding = 5) uniform sampler3D DensityLatest;	// [13e] the smoke's latest density (r) and heat (g)
layout(set = 0, binding = 6) uniform sampler3D VelocityLatest;	// [13e] the latest velocity; w the soot density

layout(push_constant) uniform SmokeLightConstants
{
	ivec4 RegionMin;		// xyz the first light cell; w the pass: 0 ambient, 1 a light
	ivec4 RegionMax;		// xyz one past the last; w light cells per smoke tile
	vec4 PositionRadius;	// xyz the light, map units from the grid's corner; w its radius
	vec4 Color;				// rgb its colour (x the look's scatter; negative when subtractive); w its luminance weight ([13e] pass 0: 1 while soot may be in the volume)
	vec4 SpotDirection;		// xyz main.fp's spot direction (the cone's axis pointing back at the light); w its shadow map row, -1 none
	vec4 Cone;				// x cos outer, y cos inner (-2, -1 for a point light); z the light cell size, map units; w the look's ambient
};

const vec3 LUMINANCE = vec3(0.2126, 0.7152, 0.0722);
const float SHADOW_ROWS = 1024.0;
const float SOOT_MIN_DENSITY = 1.0 / 1024.0;	// SMOKE_EMPTY_DENSITY: thinner than this has no soot share to speak of

// [13e] How dark the smoke at this light cell's centre is: its soot share, 0 (grey) .. 1 (black).
float SootDarkness(ivec3 cell)
{
	vec3 uvw = (vec3(cell) + 0.5) / vec3(imageSize(LightGrid));
	float density = textureLod(DensityLatest, uvw, 0.0).r;
	if (!(density > SOOT_MIN_DENSITY))
		return 0.0;
	return clamp(textureLod(VelocityLatest, uvw, 0.0).w / density, 0.0, 1.0);
}

// main.fp's shadowDirToU: a direction in the map's plane to the shadow map's u, the four projections of
// shadowmap.fp laid end to end.
float ShadowDirToU(vec2 dir)
{
	if (abs(dir.y) > abs(dir.x))
	{
		float x = dir.x / dir.y * 0.125;
		if (dir.y >= 0.0)
			return 0.125 + x;
		else
			return (0.50 + 0.125) + x;
	}
	else
	{
		float y = dir.y / dir.x * 0.125;
		if (dir.x >= 0.0)
			return (0.25 + 0.125) - y;
		else
			return (0.75 + 0.125) - y;
	}
}

// How much of a light at this row reaches a point `fromLight` away from it (Doom axes). Each shadow map
// texel holds the squared distance, in the map's plane, from the light to the first wall along that
// texel's direction (or past the radius). Three texels across the point's direction, each a lit / not
// lit test with half a light cell of bias, so a cell right against the lit face of a wall stays lit.
float ShadowVisibility(vec3 fromLight, float row)
{
	if (row < 0.0)
		return 1.0;

	vec2 dir = fromLight.xy + 0.01;		// main.fp's nudge: Doom lights often sit exactly on a plane
	float distSquared = dot(dir, dir);
	if (distSquared < 1.0)
		return 1.0;						// main.fp's "light is too close"

	ivec2 size = textureSize(ShadowMap, 0);
	int width = max(size.x, 1);
	int y = clamp(int(row), 0, min(size.y, int(SHADOW_ROWS)) - 1);
	int x = int(floor(ShadowDirToU(dir) * float(width)));

	float reach = max(sqrt(distSquared) - Cone.z * 0.5, 0.0);
	float reachSquared = reach * reach;
	float lit = 0.0;
	for (int i = -1; i <= 1; i++)
	{
		int tx = ((x + i) % width + width) % width;
		lit += step(reachSquared, texelFetch(ShadowMap, ivec2(tx, y), 0).x);
	}
	return lit / 3.0;
}

#ifdef SMOKE_EFFECT_LIGHTS

// [EFFECTLIGHTS] LD: PASS 2, THE EFFECT LIGHTS ("Engine docs/EFFECT_LIGHTS_LD_IMPL_NOTES.md"; LIGHTS_20_21_22_PLAN.md 2h).
//
// The records and world bins every consumer reads (hw_effectlightbuffer.h, where the layouts are frozen), bound here as 7
// and 8. The CPU (SmokeVolume::GatherEffectLights) dispatches this once over the light cells any effect light can reach;
// each cell loops only its own bin. A light is a segment seen from its closest point to the cell's centre (main.fp's
// EffectLightOnSurface), and from that point on it is pass 1's point light, statement for statement: attenuation 1 - d / r,
// the direction away from that point, walls through its shadow-map row (cast from where the row was made), soot darkening.
// So a light with no length lights a cell exactly as pass 1 lights it from the same place. Along a segment the brightness
// is mix(1, extra.w, share), as on surfaces. A cell's light is loaded once, its bin's lights added in bin order, and stored
// once -- only if one of them lit it.
//
// Push constants in this pass: RegionMin.w 2; PositionRadius.xyz the grid's corner (Doom axes, whole map units); Color.rgb
// the look's scatter; SpotDirection.xyz the grid's corner minus the effect-light grid's corner (Doom axes, whole map units);
// Cone.z the light cell size.

struct EffectLightRecord
{
	vec4 a;			// xyz the start this frame (shader axes: x, up, game y)   w radius
	vec4 b;			// xyz the end (== a: a point)                                 w flags
	vec4 color;		// rgb the light now                                           w shadow-map row, -1 none
	vec4 extra;		// xyz where the row was cast from                             w brightness at b as a share of a's
};

layout(set = 0, binding = 7, std430) buffer readonly EffectLightSSO
{
	uint effectLightCount;
	uint effectLightBinned;
	uint effectLightResiduals;
	uint effectLightSerial;
	EffectLightRecord effectLights[];
};

layout(set = 0, binding = 8, std430) buffer readonly EffectLightBinSSO
{
	vec4 effectLightGridCorner;		// xyz bin (0, 0, 0)'s lowest corner, shader axes   w the bin size
	ivec4 effectLightGridSize;		// xyz bins a side (0: none binned)                  w where the index list starts
	uint effectLightBinData[];		// (offset << 6) | count a bin, then the index list
};

const int EFFECT_LIGHT_ROW = 2;
const int EFFECT_LIGHT_NOSMOKE = 16;
const int EFFECT_LIGHT_BIN_LOOP_MAX = 32;

void EffectLightPass(ivec3 cell)
{
	if (effectLightGridSize.x <= 0 || effectLightGridSize.y <= 0 || effectLightGridSize.z <= 0 || !(effectLightGridCorner.w > 0.0))
		return;

	// The cell's centre (Doom axes from the grid's corner, as pass 1 takes it) and the effect-light bin it lies in.
	vec3 at = (vec3(cell) + 0.5) * Cone.z;
	vec3 binCell = floor((at + SpotDirection.xyz).xzy / effectLightGridCorner.w);
	if (any(lessThan(binCell, vec3(0.0))) || any(greaterThanEqual(binCell, vec3(effectLightGridSize.xyz))))
		return;
	ivec3 bin = ivec3(binCell);
	uint word = effectLightBinData[(bin.z * effectLightGridSize.y + bin.y) * effectLightGridSize.x + bin.x];
	int count = min(int(word & 63u), EFFECT_LIGHT_BIN_LOOP_MAX);
	if (count == 0)
		return;
	int first = effectLightGridSize.w + int(word >> 6u);
	int records = int(effectLightCount);

	vec4 grid = imageLoad(LightGrid, cell);
	vec4 stored = imageLoad(LightDirection, cell);	// w: the soot darkness pass 0 kept
	vec3 light = grid.rgb;
	float total = grid.a;
	vec3 direction = stored.xyz;
	bool lit = false;
	for (int k = 0; k < count; k++)
	{
		int index = int(effectLightBinData[first + k]);
		if (index >= records)
			continue;
		EffectLightRecord record = effectLights[index];
		int flags = int(record.b.w);
		if ((flags & EFFECT_LIGHT_NOSMOKE) != 0)
			continue;
		vec3 tint = record.color.rgb * Color.rgb;	// x the look's scatter, as pass 1's colour
		float luminance = dot(tint, LUMINANCE);
		if (!(luminance > 0.0))
			continue;

		// The closest point on the segment to the cell's centre; a point light is its own closest point.
		vec3 start = record.a.xzy - PositionRadius.xyz;
		vec3 segment = record.b.xzy - record.a.xzy;
		float lengthSquared = dot(segment, segment);
		float share = lengthSquared > 0.0 ? clamp(dot(at - start, segment) / lengthSquared, 0.0, 1.0) : 0.0;
		vec3 closest = share > 0.0 ? start + segment * share : start;

		// Pass 1's point light at that point (no cone).
		vec3 fromLight = at - closest;
		float distSquared = dot(fromLight, fromLight);
		float radius = record.a.w;
		if (radius <= 0.0 || distSquared >= radius * radius)
			continue;

		float dist = sqrt(distSquared);
		float attenuation = 1.0 - dist / radius;
		vec3 travel = dist > 1e-3 ? fromLight / dist : vec3(0.0);	// the way the light goes through this cell
		if (share > 0.0)
			attenuation *= mix(1.0, record.extra.w, share);
		if (attenuation <= 0.0)
			continue;
		if ((flags & EFFECT_LIGHT_ROW) != 0)
		{
			attenuation *= ShadowVisibility(at - (record.extra.xzy - PositionRadius.xyz), record.color.w);
			if (attenuation <= 0.0)
				continue;
		}

		float weight = luminance * attenuation;
		float sum = total + weight;
		if (sum > 1e-6)
		{
			direction = (direction * total + travel * weight) / sum;
			float shareLength = length(direction);
			if (shareLength > 1.0)
				direction /= shareLength;
		}
		vec3 added = tint * attenuation;
		if (stored.w > 0.0)
			added *= 1.0 - stored.w;	// [13e] sooty smoke sends back less of this light
		light += added;
		total = sum;
		lit = true;
	}
	if (lit)
	{
		imageStore(LightGrid, cell, vec4(light, total));
		imageStore(LightDirection, cell, vec4(direction, stored.w));
	}
}

#endif

#ifdef SMOKE_SURFACE_LIGHT

// [13F] SURFACE LIGHT IN PASS 0 ("Engine docs/SMOKE_13F_IMPL_NOTES.md"; hw_framecompute.h, SmokeSurfaceLightFrame).
//
// main.fp's getLightColor for a cell of air instead of a surface, in its order: the room's light (the column's sector light)
// through the darkness curve and the passed look; the strongest recolour band; the glow lanes; the band loop (lift, crush,
// add). Per cell, at its centre. Where the air is not a surface, this lump defines it:
//   - a WALL LANE lights the air by the cell's height above the column's floor plane (below its ceiling plane): the wall
//     glow's own measure (main.vp's glowdist), taken at the column;
//   - a FLAT LANE lights the air above (below) the flat as the flat glows at the column -- its distance to the sector's
//     nearest edge, over the lines hw_flats.cpp uploads -- fading with height over the same reach and falloff;
//   - a height below a plane counts as 0 (the solid under a floor reads the glow at the floor, so trilinear reads meet no
//     dark rim);
//   - the animated glow terms (wave, flow, cells) are their level-wide means (surfaceGlowWave, from the CPU), and a band's fill
//     is its mean coverage (folded into surfaceBandColor and surfaceBandFill by the CPU);
//   - all of it only in ACTIVE tiles, pass 1's rule (every light cell the trilinear footprint of a march sample near smoke reads
//     lies in an active tile: "Engine docs/SMOKE_13D_IMPL_NOTES.md", mirror L10): a quiet tile keeps the column's light exactly
//     as pass 0 always wrote it, for one tile fetch, so the pass costs what the smoke covers, not the whole grid.
// Buffers: hw_framecompute.h. Doom axes, map units from the grid's corner.

layout(set = 0, binding = 7, std430) buffer readonly SmokeSurfaceColumnSSO
{
	ivec4 surfaceColumnSize;		// xy the light grid's columns
	vec2 surfaceColumns[];			// per column, x fastest: its sector record (-1: the fallback's), its flat-edge distance (-1: not known)
};

layout(set = 0, binding = 8, std430) buffer readonly SmokeSurfaceSSO
{
	vec4 surfaceSwitches;			// x 1 = the glow lanes are on; y the bands the light loops read (0 none); z the sweep trail; w the fallback's record
	vec4 surfacePassed;				// main.fp's uSweepPassed: x tint mix, y darken, z desaturate, w the ramp (map units)
	vec4 surfacePassedTint;			// rgb main.fp's uSweepPassedColor; w the bands SurfacePassedAt reads (0 = the look is off)
	vec4 surfaceDarkSpace;			// x distance depth, y distance range, z height depth, w height range (main.fp's uDarkness2 / 3)
	vec4 surfaceDarkEye;			// xyz the eye; w the height reference
	vec4 surfaceDesatKeep;			// main.fp's uDesatKeep: x threshold, y softness, z hue gate, w the level's drain
	vec4 surfaceGlowWave;			// x the reach scale (already in the records), y brightness x texture means, z the colour shift
	vec4 surfaceBandOrigin[8];		// main.fp's uSweepBandOrigin: xyz the origin; w the shape, the band's own or the shared one
	vec4 surfaceBandShape[8];		// main.fp's uSweepBands: x radius, y thickness, z softness, w the word (draw + 16 fill + 256 passed)
	vec4 surfaceBandColor[8];		// rgb its colour (a fill's mean folded in, but for recolour bands); w its intensity
	vec4 surfaceBandFill[8];		// x the fill's multiplier on the band's coverage (1 = no fill); y 1 = the solid fill
	vec4 surfaceRecords[];			// sector records (x darkness curve or -1, y glow record or -1, z desaturation), then glow records
};

const int SURFACE_BANDS = 8;
const int SURFACE_GLOW_VEC4S = 14;

// main.fp's desaturate(): the stronger of the column sector's colormap byte and the level's drain, sparing saturated colours
// as uDesatKeep says (dodesaturate).
vec3 SurfaceDesaturate(vec3 texel, float sectorDesaturation)
{
	float factor = max(sectorDesaturation, surfaceDesatKeep.w);
	if (factor != 0.0)
	{
		float gray = dot(texel, LUMINANCE);
		if (surfaceDesatKeep.x > 0.0)
		{
			float mx = max(max(texel.r, texel.g), texel.b);
			float mn = min(min(texel.r, texel.g), texel.b);
			float sat = (mx > 0.0001) ? (mx - mn) / mx : 0.0;
			int gate = int(surfaceDesatKeep.z);
			bool hueOk = (gate == 0) || (gate == 1 && texel.r >= mx) || (gate == 2 && texel.g >= mx) || (gate == 3 && texel.b >= mx);
			if (hueOk)
			{
				float lo = surfaceDesatKeep.x;
				float hi = min(lo + max(surfaceDesatKeep.y, 0.001), 1.0);
				factor *= 1.0 - smoothstep(lo, hi, sat);
			}
		}
		return mix(texel, vec3(gray), factor);
	}
	return texel;
}

// main.fp's SweepShapeDist in Doom axes: its shader-space y is Doom's z, its z Doom's y.
float SurfaceShapeDist(int shape, vec3 p, vec3 o)
{
	if (shape == 1)      return length(p.xy - o.xy);
	else if (shape == 2) return abs(p.x - o.x);
	else if (shape == 3) return abs(p.y - o.y);
	else if (shape == 5) return p.z - o.z;
	else if (shape == 6) return p.x - o.x;
	else if (shape == 7) return p.y - o.y;
	else if (shape == 8) return o.x - p.x;
	else if (shape == 9) return o.y - p.y;
	return length(p - o);	// 4, the sphere
}

// main.fp's SweepBandAttenAt: how strongly a band covers p, 0 if it does not.
float SurfaceBandAtten(int band, vec3 p)
{
	vec4 shape = surfaceBandShape[band];
	if (shape.w <= 0.0)
		return 0.0;
	vec4 origin = surfaceBandOrigin[band];
	int mode = int(origin.w);
	if (mode <= 0)
		return 0.0;
	float ahead = SurfaceShapeDist(mode, p, origin.xyz) - shape.x;
	float thick = max(shape.y, 0.001);
	float trail = abs(surfaceSwitches.z);
	float behind = (surfaceSwitches.z >= 0.0) ? -ahead : ahead;
	float width = (trail > thick && behind > 0.0) ? trail : thick;
	float across = abs(ahead);
	if (across >= width)
		return 0.0;
	return pow(1.0 - across / width, max(shape.z, 0.01));
}

// main.fp's SweepPassedAt: how far behind the strongest passed band's front p is, 0..1.
float SurfacePassedAt(vec3 p)
{
	float strongest = 0.0;
	float ramp = max(surfacePassed.w, 1.0);
	int count = int(surfacePassedTint.w);
	for (int band = 0; band < SURFACE_BANDS; band++)
	{
		if (band >= count)
			break;
		int word = int(surfaceBandShape[band].w);
		if (((word >> 8) & 1) == 0)
			continue;
		vec4 origin = surfaceBandOrigin[band];
		int shape = int(origin.w);
		if (shape <= 0)
			continue;
		float ahead = SurfaceShapeDist(shape, p, origin.xyz) - surfaceBandShape[band].x;
		strongest = max(strongest, clamp(-ahead / ramp, 0.0, 1.0));
	}
	return strongest;
}

// main.fp's DarknessAt past its curve (the CPU works the curve out per sector): deeper with distance from the eye, and below
// the height reference.
float SurfaceDarkness(float curve, vec3 p)
{
	float mul = curve;
	if (surfaceDarkSpace.x > 0.0)
	{
		float d = distance(p, surfaceDarkEye.xyz) / max(surfaceDarkSpace.y, 1.0);
		mul *= 1.0 - surfaceDarkSpace.x * clamp(d, 0.0, 1.0);
	}
	if (surfaceDarkSpace.z > 0.0)
	{
		float below = (surfaceDarkEye.w - p.z) / max(surfaceDarkSpace.w, 1.0);
		mul *= 1.0 - surfaceDarkSpace.z * clamp(below, 0.0, 1.0);
	}
	return clamp(mul, 0.0, 1.0);
}

// main.fp's four glow falloffs: 0 linear, 1 quadratic, 2 square root, anything else exponential.
float SurfaceFalloff(int falloff, float frac)
{
	if (falloff == 0)      return 1.0 - frac;
	else if (falloff == 1) return 1.0 - frac * frac;
	else if (falloff == 2) return 1.0 - sqrt(frac);
	return exp(-frac * 3.0);
}

// A wall lane (main.fp's glowing-walls block) at distance d from its plane. Its three vec4s: near colour + reach, far colour +
// set, falloff + intensity + present.
vec3 SurfaceWallLane(int at, float d, vec3 tint, float tintWeight, float desaturation)
{
	vec4 lane = surfaceRecords[at + 2];
	vec4 nearColour = surfaceRecords[at];
	if (!(lane.z > 0.0) || !(d < nearColour.a))
		return vec3(0.0);
	vec4 farColour = surfaceRecords[at + 1];
	float atten = SurfaceFalloff(int(lane.x), d / nearColour.a);
	vec3 glow = nearColour.rgb;
	if (farColour.a > 0.0)
		glow = mix(farColour.rgb, glow, clamp(atten + surfaceGlowWave.z, 0.0, 1.0));
	glow = mix(glow, tint, tintWeight);
	return SurfaceDesaturate(glow * atten * lane.y * surfaceGlowWave.y, desaturation);
}

// A flat lane (main.fp's flat-edge glow) in the air: the flat's glow at this column's edge distance, fading over the same
// reach and falloff with the height d above (below) the flat. The same three vec4s (intensity 1: hw_flats.cpp folds it in).
vec3 SurfaceFlatLane(int at, float edgeDistance, float d, vec3 tint, float tintWeight, float desaturation)
{
	vec4 lane = surfaceRecords[at + 2];
	vec4 nearColour = surfaceRecords[at];
	if (!(lane.z > 0.0) || !(edgeDistance >= 0.0) || !(edgeDistance < nearColour.a) || !(d < nearColour.a))
		return vec3(0.0);
	vec4 farColour = surfaceRecords[at + 1];
	int falloff = int(lane.x);
	float atten = SurfaceFalloff(falloff, edgeDistance / nearColour.a);
	vec3 glow = nearColour.rgb;
	if (farColour.a > 0.0)
		glow = mix(farColour.rgb, glow, clamp(atten + surfaceGlowWave.z, 0.0, 1.0));
	glow = mix(glow, tint, tintWeight);
	return SurfaceDesaturate(glow * atten * lane.y * surfaceGlowWave.y * SurfaceFalloff(falloff, d / nearColour.a), desaturation);
}

// Pass 0's light for this cell: the column's sector light, graded by the room's darkness and passed look, plus the glow its
// sector gives the air and the bands' light.
vec3 SurfaceAmbient(ivec3 cell)
{
	vec3 color = texelFetch(AmbientColumns, cell.xy, 0).rgb;
	if (texelFetch(TileActive, cell / max(RegionMax.w, 1), 0).r < 0.5)
		return color;	// a quiet tile: pass 0's own light (pass 1's tile rule)
	vec3 at = (vec3(cell) + 0.5) * Cone.z;	// the cell's centre, as pass 1 takes it

	vec2 column = vec2(-1.0);
	if (cell.x < surfaceColumnSize.x && cell.y < surfaceColumnSize.y)
	{
		int columnIndex = cell.y * surfaceColumnSize.x + cell.x;
		if (columnIndex < surfaceColumns.length())
			column = surfaceColumns[columnIndex];
	}
	int records = surfaceRecords.length();
	int slot = column.x >= 0.0 ? int(column.x) : int(surfaceSwitches.w);
	if (slot < 0 || slot >= records)
		return color;
	vec4 sector = surfaceRecords[slot];

	// The room's light (main.fp: darkness, then the passed look).
	if (sector.x >= 0.0)
		color *= SurfaceDarkness(sector.x, at);
	if (surfacePassedTint.w > 0.0)
	{
		float passed = SurfacePassedAt(at);
		if (passed > 0.0)
		{
			vec3 graded = color * (1.0 - clamp(surfacePassed.y, 0.0, 1.0));
			graded = mix(graded, vec3(dot(graded, LUMINANCE)), clamp(surfacePassed.z, 0.0, 1.0));
			graded = mix(graded, graded * surfacePassedTint.rgb, clamp(surfacePassed.x, 0.0, 1.0));
			color = mix(color, graded, passed);
		}
	}

	// The light the surfaces and the bands give the air.
	int bands = int(surfaceSwitches.y);
	int glowAt = surfaceSwitches.x > 0.5 ? int(sector.y) : -1;
	if (glowAt < 0 || glowAt + SURFACE_GLOW_VEC4S > records)
		glowAt = -1;
	if (glowAt >= 0 || bands > 0)
	{
		if (glowAt >= 0)
		{
			// main.fp's sweep recolour: the strongest recolour band tints every lane.
			vec3 tint = vec3(0.0);
			float tintWeight = 0.0;
			for (int band = 0; band < SURFACE_BANDS; band++)
			{
				if (band >= bands)
					break;
				if ((int(surfaceBandShape[band].w) & 15) != 4)
					continue;
				float cover = SurfaceBandAtten(band, at) * surfaceBandColor[band].a;
				if (cover > tintWeight)
				{
					tintWeight = cover;
					tint = surfaceBandColor[band].rgb;
				}
			}
			tintWeight = clamp(tintWeight, 0.0, 1.0);

			// The planes (xyz: z = a x + b y + c; w: the longest reach of that plane's lanes -- further away neither can light).
			vec4 floorPlane = surfaceRecords[glowAt];
			vec4 ceilingPlane = surfaceRecords[glowAt + 1];
			float aboveFloor = max(at.z - dot(floorPlane.xyz, vec3(at.xy, 1.0)), 0.0);
			float belowCeiling = max(dot(ceilingPlane.xyz, vec3(at.xy, 1.0)) - at.z, 0.0);
			bool nearFloor = aboveFloor < floorPlane.w;
			bool nearCeiling = belowCeiling < ceilingPlane.w;
			if (nearCeiling)
				color += SurfaceWallLane(glowAt + 5, belowCeiling, tint, tintWeight, sector.z);	// main.fp's top lane: the ceiling's
			if (nearFloor)
				color += SurfaceWallLane(glowAt + 2, aboveFloor, tint, tintWeight, sector.z);	// its bottom lane: the floor's
			if (nearFloor)
				color += SurfaceFlatLane(glowAt + 8, column.y, aboveFloor, tint, tintWeight, sector.z);
			if (nearCeiling)
				color += SurfaceFlatLane(glowAt + 11, column.y, belowCeiling, tint, tintWeight, sector.z);
		}

		// main.fp's band loop: lift and crush scale what is there, the others add.
		for (int band = 0; band < SURFACE_BANDS; band++)
		{
			if (band >= bands)
				break;
			int mode = int(surfaceBandShape[band].w) & 15;
			if (mode <= 0 || mode == 4)
				continue;
			float atten = SurfaceBandAtten(band, at);
			if (atten <= 0.0)
				continue;
			vec4 fill = surfaceBandFill[band];
			atten = fill.y > 0.5 ? fill.x : atten * fill.x;
			vec4 bandColour = surfaceBandColor[band];
			if (mode == 2)
				color *= 1.0 + atten * bandColour.a;
			else if (mode == 3)
				color *= max(0.0, 1.0 - atten * bandColour.a);
			else
				color += SurfaceDesaturate(bandColour.rgb * atten * bandColour.a, sector.z);
		}
		color = max(color, vec3(0.0));
	}
	return color;
}

#endif

void main()
{
	ivec3 cell = ivec3(gl_GlobalInvocationID) + RegionMin.xyz;
	if (any(greaterThanEqual(cell, RegionMax.xyz)))
		return;

	if (RegionMin.w == 0)
	{
#ifdef SMOKE_SURFACE_LIGHT
		vec3 ambient = SurfaceAmbient(cell) * Cone.w;	// [13F] the column's light, graded, with its sector's glow and the bands' light
#else
		vec3 ambient = texelFetch(AmbientColumns, cell.xy, 0).rgb * Cone.w;
#endif
		float weight = dot(ambient, LUMINANCE);
		// [13e] The soot darkness, kept in the direction grid's w for pass 1 and the beam scatter.
		float darkness = 0.0;
		if (Color.w > 0.5)
		{
			darkness = SootDarkness(cell);
			ambient *= 1.0 - darkness;
		}
		imageStore(LightGrid, cell, vec4(ambient, weight));
		imageStore(LightDirection, cell, vec4(0.0, 0.0, 0.0, darkness));
		return;
	}

	ivec3 tile = cell / max(RegionMax.w, 1);
	if (texelFetch(TileActive, tile, 0).r < 0.5)
		return;

#ifdef SMOKE_EFFECT_LIGHTS
	if (RegionMin.w == 2)
	{
		EffectLightPass(cell);	// [EFFECTLIGHTS] LD: pass 2
		return;
	}
#endif

	vec3 fromLight = (vec3(cell) + 0.5) * Cone.z - PositionRadius.xyz;
	float distSquared = dot(fromLight, fromLight);
	float radius = PositionRadius.w;
	if (radius <= 0.0 || distSquared >= radius * radius)
		return;

	float dist = sqrt(distSquared);
	float attenuation = 1.0 - dist / radius;
	vec3 travel = dist > 1e-3 ? fromLight / dist : vec3(0.0);	// the way the light goes through this cell
	attenuation *= smoothstep(Cone.x, Cone.y, dot(-travel, SpotDirection.xyz));
	if (attenuation <= 0.0)
		return;
	attenuation *= ShadowVisibility(fromLight, SpotDirection.w);
	if (attenuation <= 0.0)
		return;

	vec4 grid = imageLoad(LightGrid, cell);
	vec4 stored = imageLoad(LightDirection, cell);	// [13e] w: the soot darkness pass 0 kept
	vec3 weighted = stored.xyz;
	float weight = max(Color.w, 0.0) * attenuation;
	float total = grid.a + weight;
	vec3 direction = weighted;
	if (total > 1e-6)
	{
		direction = (weighted * grid.a + travel * weight) / total;
		float share = length(direction);
		if (share > 1.0)
			direction /= share;
	}
	vec3 added = Color.rgb * attenuation;
	if (stored.w > 0.0)
		added *= 1.0 - stored.w;	// [13e] sooty smoke sends back less of this light
	imageStore(LightGrid, cell, vec4(grid.rgb + added, total));
	imageStore(LightDirection, cell, vec4(direction, stored.w));
}
