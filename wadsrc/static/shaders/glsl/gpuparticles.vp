/*
** gpuparticles.vp
**
** [GPUPARTICLES] Stateless particles: a record holds starting conditions and
** this shader works out where the particle is NOW. Nothing is simulated per
** frame. See "Engine docs/GPU_PARTICLES_PLAN.md" and hw_gpuparticlebuffer.h.
**
** Vulkan only. The record buffer (GpuParticleSSO, set 1 binding 5) and the
** particle definitions (ParticleDefinitionSSO, set 1 binding 7) are declared in
** vk_shader.cpp's prolog; GL and GLES never load this effect.
**
** [PARTICLEDEFS] Stage 2 record, shader space (y is up), 80 bytes
** ("Engine docs/GPU_PARTICLES_STAGE2_PLAN.md" 2b):
**   a  xyz spawn position                 w  birth, level seconds
**   b  xyz initial velocity, units/s      w  life, seconds (0 = free slot)
**   c  rgb tint (x definition colour)     w  intensity scale
**   d  x definition slot  y size scale  z ambient light at spawn 0..1  w seed 0..1
**   e  xy surface normal (octahedral; x = 2 no plane)  z plane offset  w floor height (-32768 none)
**
** What a particle looks like over its life is its definition's: size, colour,
** alpha and emissive ramps on shared time keys, gravity, drag, a size cap, orient,
** stretch, spin, collision and flags (layout: particledefs.h / the prolog).
**
** [2b] LEGACY records (r_gpuparticles_legacy on, the bring-up A/B) keep the stage
** 1 layout -- c rgb colour, w intensity; d size start, size end, gravity, drag;
** e.y stretch -- with e.x = orient - 16. No stage 2 record has e.x below -1, so
** each record says which kind it is, and DrawLegacyParticle is the stage 1 code.
**
** [2c] FLIPBOOKS. A definition whose flipbook.x is an atlas layer (not -1) is
** textured: which frame is showing is worked out here, once per particle, from its
** age -- never from anything random -- and handed to gpuparticles.fp flat, as the
** two frames' atlas layers and how far the particle is from one to the next.
**
** [2d] LIT, OCCLUDING PARTICLES. A definition with alpha above 0 hides what is
** behind it. Its body colour -- tint x colour ramp, lit by the sector light it was
** spawned in plus the dynamic lights in view (ViewLightSSO below), in proportion to
** its `lit` -- and its alpha ramp go to gpuparticles.fp flat, with its own soft
** distance. They are only drawn while RenderTranslucent uses the premultiplied blend
** (uGpuParticleParams2.y = 1, while such a particle is alive); the light loop runs
** only then, and only for particles that are lit and not transparent at that moment.
**
** [LOOKS] GENERATED LOOKS ("Engine docs/GPU_PARTICLE_LOOKS_PLAN.md", build A). A
** definition whose look (spare[0].x) is not none, drawn while r_gpuparticles_looks
** (uGpuParticleParams2.z) is above 0, hands gpuparticles.fp its life fraction, age,
** seed and drawn size (vParticleLife), from which the fragment shader generates the
** shape in the particle's own space. A lit dust look also gets the direction its light
** comes from (vParticleLightDir), summed inside ParticleViewLight's existing loop. With
** no look both outputs are zero and everything else is computed exactly as before.
**
** [PARTICLECULL] E11 CULL AND LOD ("Engine docs/EFFECTS_OPTIMIZATION_PLAN.md" E11, "Engine
** docs/PARTICLE_CULL_E11_IMPL_NOTES.md"). While r_gpuparticles_cull is on, a particle or
** debris billboard whose whole quad lies outside this view collapses before its lights,
** flipbook and look (ParticleOutsideView); it had nothing to draw, so the image is the same.
** Past r_gpuparticles_light_lod_distance, when that is set, a lit one skips the effect lights
** (ParticleEffectLightShare). Both off, every particle takes the path it took before E11.
**
**---------------------------------------------------------------------------
**
** Copyright 2026 UZDXREMA
**
** SPDX-License-Identifier: GPL-3.0-or-later
**
**---------------------------------------------------------------------------
*/

// Slot index low/high 16 bits, corner 0..5, unused. C++ calls this location
// VATTR_BONESELECTOR; it is the only integer attribute the engine has.
layout(location = 8) in uvec4 aParticle;

layout(location = 0) out vec2 vParticleCorner;
layout(location = 1) out vec4 vParticleColor;
// [2c] x the atlas layer of the frame showing (-1 = untextured, the round dot)
// y the next frame's layer  z how far into it, 0..1  w the definition slot (-1 for
// a legacy record).
layout(location = 2) flat out vec4 vParticleFlipbook;
// [2d] rgb the lit body colour (tint x colour ramp x light)  a the occlusion 0..1
// (alpha ramp x fade). Zero for a legacy record or a dead slot.
layout(location = 3) flat out vec4 vParticleBody;
// [2d] The definition's own soft distance in map units: -1 = not set (use
// r_gpuparticles_soft), 0 = hard edges.
layout(location = 4) flat out float vParticleSoft;
// [LOOKS] x the life fraction 0..1  y the age in seconds  z the seed 0..1  w the drawn
// diameter in map units: what gpuparticles.fp needs to generate a look in the particle's own
// space, world-sized. Written only for a definition with a look while r_gpuparticles_looks
// (uGpuParticleParams2.z) is above 0; zero otherwise, which is the fragment shader's test
// (a drawn particle's diameter is never 0).
layout(location = 5) flat out vec4 vParticleLife;
// [LOOKS] xyz the direction the view lights come from, in the quad's own axes -- x and y those
// of vParticleCorner, z out of the quad toward the eye  w how much of the particle's light
// comes from that direction, 0..1, times its `lit`. Only for a lit dust look drawn under the
// premultiplied blend at look quality 2 or more, with a light reaching it; zero otherwise.
layout(location = 6) flat out vec4 vParticleLightDir;

// [2d] THE VIEW LIGHTS (ViewLightBuffer, hw_viewlightbuffer.h): the dynamic lights in
// view nearest the eye, world space, filled on the CPU every main-view scene. Set 1
// binding 8, vertex stage only. Declared here, not in vk_shader.cpp's shared prolog,
// so no other shader changes; any other vertex-stage effect that wants the lights
// declares the same block. Four vec4s per light, 64 bytes, std430 -- must match
// ViewLightRecord:
//   origin         xyz position  w radius
//   color          rgb colour x intensity (negative: subtractive)
//   spotDirection  xyz, dotted with the direction TO the light (0 for a point light)
//   spotCone       x cos outer  y cos inner (a point light: -2, -1)
struct ViewLight { vec4 origin; vec4 color; vec4 spotDirection; vec4 spotCone; };
layout(set = 1, binding = 8, std430) buffer readonly ViewLightSSO
{
	vec4 viewLightInfo;		// x how many lights are live
	ViewLight viewLights[];
};

// ViewLightBuffer::CAPACITY.
const int kViewLightCapacity = 32;

#ifdef EFFECT_LIGHTS
// [PARTICLELIGHTS] EFFECT LIGHTS ON PARTICLES ("Engine docs/EFFECT_LIGHTS_LC_IMPL_NOTES.md"; LIGHTS_20_21_22_PLAN.md
// 2h). Sparks, embers, impacts and tracers that belong to no actor, sorted by the CPU into world bins around the eye once a frame for
// both eyes (hw_effectlights.cpp). The light at a point loops only that point's bin, as main.fp's EffectLightsAt does for a pixel --
// with no N.L (a particle is not a surface) and no wall test (no shadow map in the vertex stage); a light marked
// EFFECT_LIGHT_NOPARTICLES is skipped. Compiled only with EFFECT_LIGHTS, which vk_shader.cpp defines for this lump's vertex
// programs; without it this lump is exactly what it was.
//
// The layouts are hw_effectlightbuffer.h's, the same blocks main.fp declares: set 1 bindings 14 and 15, in every pipeline layout
// for the vertex and fragment stages (vk_descriptorset.cpp).
//   EffectLightRecord   a xyz the start this frame, w radius    b xyz the end (== a: a point), w flags
//                       color rgb the light now, w shadow-map row    extra w the brightness at b as a share of a's
//   EffectLightBinSSO   the occupied grid's lowest corner (w the bin size) and bins a side (w where the index list starts), then
//                       a word a bin, (offset << 6) | count, then the index list
struct EffectLightRecord
{
	vec4 a;
	vec4 b;
	vec4 color;
	vec4 extra;
};

layout(set = 1, binding = 14, std430) buffer readonly EffectLightSSO
{
	uint effectLightCount;
	uint effectLightBinned;
	uint effectLightResiduals;
	uint effectLightSerial;
	EffectLightRecord effectLights[];
};

layout(set = 1, binding = 15, std430) buffer readonly EffectLightBinSSO
{
	vec4 effectLightGridCorner;
	ivec4 effectLightGridSize;
	uint effectLightBinData[];
};

// hw_effectlightbuffer.h's EFFECT_LIGHT_GPU_NOPARTICLES and EFFECT_LIGHT_BIN_LOOP_MAX.
const int EFFECT_LIGHT_NOPARTICLES = 32;
const int EFFECT_LIGHT_BIN_LOOP_MAX = 32;

// The effect light at p from the lights of p's bin: each seen from the closest point of its segment, attenuated (radius -
// distance) / radius and, along a line, by its brightness share -- EffectLightOnSurface's statements without the facing and the
// wall.
vec3 EffectLightsAtParticle(vec3 p)
{
	if (effectLightGridSize.x <= 0)
		return vec3(0.0);
	vec3 cellf = floor((p - effectLightGridCorner.xyz) / effectLightGridCorner.w);
	if (any(lessThan(cellf, vec3(0.0))) || any(greaterThanEqual(cellf, vec3(effectLightGridSize.xyz))))
		return vec3(0.0);
	ivec3 cell = ivec3(cellf);
	uint word = effectLightBinData[(cell.z * effectLightGridSize.y + cell.y) * effectLightGridSize.x + cell.x];
	int first = effectLightGridSize.w + int(word >> 6u);
	int count = min(int(word & 63u), EFFECT_LIGHT_BIN_LOOP_MAX);
	int records = int(effectLightCount);
	vec3 total = vec3(0.0);
	for (int k = 0; k < count; k++)
	{
		int index = int(effectLightBinData[first + k]);
		if (index >= records)
			continue;
		EffectLightRecord light = effectLights[index];
		if ((int(light.b.w) & EFFECT_LIGHT_NOPARTICLES) != 0)
			continue;
		vec3 segment = light.b.xyz - light.a.xyz;
		float lengthSquared = dot(segment, segment);
		float share = lengthSquared > 0.0 ? clamp(dot(p - light.a.xyz, segment) / lengthSquared, 0.0, 1.0) : 0.0;
		vec3 closest = share > 0.0 ? light.a.xyz + segment * share : light.a.xyz;
		float lightdistance = distance(closest, p);
		if (light.a.w < lightdistance)
			continue;
		float attenuation = clamp((light.a.w - lightdistance) / light.a.w, 0.0, 1.0);
		if (share > 0.0)
			attenuation *= mix(1.0, light.extra.w, share);
		total += light.color.rgb * attenuation;
	}
	return total;
}

// [PARTICLECULL] E11 LIGHT LOD: how much of the effect lights a lit particle at p takes, by its distance from this view's camera.
// r_gpuparticles_light_lod_distance (|uGpuParticleParams2.w| - 1, map units) at 0, the default, is off: 1 everywhere, and
// ParticleViewLight reads the bin exactly as it did before E11. Above 0: 1 nearer than three quarters of it, 0 at it and beyond --
// where ParticleViewLight does not read the bin at all -- and a smoothstep between, so a particle drifting out of range dims
// rather than pops. The view lights and the sector light are not touched.
float ParticleEffectLightShare(vec3 p)
{
	float lodDistance = abs(uGpuParticleParams2.w) - 1.0;
	if (!(lodDistance > 0.0))
		return 1.0;
	return 1.0 - smoothstep(0.75 * lodDistance, lodDistance, distance(p, uCameraPos.xyz));
}
#endif

const vec2 kParticleCorners[6] = vec2[6](
	vec2(-1.0, -1.0), vec2( 1.0, -1.0), vec2( 1.0,  1.0),
	vec2(-1.0, -1.0), vec2( 1.0,  1.0), vec2(-1.0,  1.0));

// ParticleDefinitionBuffer::SLOTS: 256 named + 256 inline.
const int kParticleDefinitionSlots = 512;

// [LOOKS] A definition's generated look lives in the record's spare vec4s (particledefs.h,
// EParticleLook). The prolog's struct keeps the name `spare`, so these name the fields here:
//   ParticleLookShape  x kind (0 none 1 dust 2 smoke 3 fire 4 flash 5 spark)  y roughness  z churn  w detail
//   ParticleLookHeat   x heat start  y heat end  z prongs (min * 32 + max)  w rise
#define ParticleLookShape(slot) particleDefinitions[slot].spare[0]
#define ParticleLookHeat(slot) particleDefinitions[slot].spare[1]
// The EParticleLook values whose shading uses the lights' direction.
const int kLookDust = 1;
const int kLookSmoke = 2;

// A particle outside its life puts all six vertices on one point outside the
// clip volume: zero-area triangles never rasterise, so a dead slot costs six
// vertex invocations and nothing else.
void CollapseParticle()
{
	gl_Position = vec4(2.0, 2.0, 2.0, 1.0);
	vParticleCorner = vec2(0.0);
	vParticleColor = vec4(0.0);
	vParticleFlipbook = vec4(-1.0, -1.0, 0.0, -1.0);
	vParticleBody = vec4(0.0);
	vParticleSoft = -1.0;
	vParticleLife = vec4(0.0);
	vParticleLightDir = vec4(0.0);
}

// [PARTICLECULL] E11: A PARTICLE OUTSIDE THE VIEW COLLAPSES BEFORE ITS EXPENSIVE WORK ("Engine docs/EFFECTS_OPTIMIZATION_PLAN.md"
// E11, "Engine docs/PARTICLE_CULL_E11_IMPL_NOTES.md"). Every drawn particle used to run its whole vertex path -- a lit one's view
// light and effect light loops included -- even when its quad lay wholly off to one side of the view or behind the eye, where the
// clipper threw every triangle of it away. Now DrawDefinedParticle and DrawPooledParticle ask ParticleOutsideView once the drawn
// centre and size are known (after collision, which moves the centre) and collapse such a particle as a dead slot is collapsed,
// before its lights, flipbook and look. Per view: under multiview ProjectionMatrix and ViewMatrix are gl_ViewIndex's, and without
// it each eye's pass has its own. Nothing such a particle could draw is lost, so the image is fragment for fragment the one
// before E11 (the notes' draw harness). Legacy records are not culled: they have no light work.
//
// uGpuParticleParams2.w packs this stage's two renderer-read knobs (HWDrawInfo::StartScene); a viewpoint that never went through
// StartScene holds 0, which is both off:
//   sign     above 0: r_gpuparticles_cull on (the default); 0 or below: off, every particle takes its path from before E11
//   |w| - 1  r_gpuparticles_light_lod_distance in map units, 0 = off (ParticleEffectLightShare)

// sqrt(2), rounded up: a corner (+-1, +-1) of the quad, turned by any spin, lies this far from the centre in quad units.
const float kParticleCullCornerReach = 1.41422;
// How far past a face a particle must lie before it is culled, as a share of the magnitudes its test is made of -- the clip
// coordinates, the quad's reach, and the world position and view translation the centre came from. Far above the rounding of the
// vertex path in float32, fused or not; small beside the view (the notes give the numbers).
const float kParticleCullMargin = 1.0e-5;

// True when every point of this particle's quad lies outside one face of this view's clip volume, whatever its corner and spin, so
// every triangle of it is clipped away; the answer is the same for all six vertices. pos is the drawn centre, vel the velocity a
// streak follows, halfSize half the drawn size; orient and stretch as ParticleEyePosition takes them.
//   orient 0, 1  the corners are offset in eye space, in the view plane: within reach x max(halfSize, |the streak's half length|)
//                of the centre, along the clip-space axes ProjectionMatrix[0] and [1].
//   orient 2     the corners are offset in the world: within reach x halfSize, along ProjectionMatrix x ViewMatrix[0], [1], [2].
// The faces are the four side faces, w + x, w - x, w + y and w - y >= 0, and w >= 0, which those imply. Never the near or far face:
// the scene draws with depth clamp on, which turns them off, so a particle nearer than the near plane still draws.
bool ParticleOutsideView(vec3 pos, vec3 vel, float halfSize, int orient, float stretch)
{
	vec4 centre = ProjectionMatrix * (ViewMatrix * vec4(pos, 1.0));
	vec4 axisX;
	vec4 axisY;
	vec4 axisZ;
	float reach;
	if (orient == 2)
	{
		axisX = ProjectionMatrix * ViewMatrix[0];
		axisY = ProjectionMatrix * ViewMatrix[1];
		axisZ = ProjectionMatrix * ViewMatrix[2];
		reach = kParticleCullCornerReach * halfSize;
	}
	else
	{
		axisX = ProjectionMatrix[0];
		axisY = ProjectionMatrix[1];
		axisZ = vec4(0.0);
		float halfLength = halfSize;
		if (orient == 1)
			halfLength = halfSize + length((mat3(ViewMatrix) * vel).xy) * stretch * uGpuParticleParams.z;
		reach = kParticleCullCornerReach * max(halfSize, abs(halfLength));
	}

	// The side faces as (w + x, w - x, w + y, w - y): the centre's value, negative outside, and how far the quad can move it.
	vec4 face = centre.wwww + vec4(centre.x, -centre.x, centre.y, -centre.y);
	vec4 faceX = axisX.wwww + vec4(axisX.x, -axisX.x, axisX.y, -axisX.y);
	vec4 faceY = axisY.wwww + vec4(axisY.x, -axisY.x, axisY.y, -axisY.y);
	vec4 faceZ = axisZ.wwww + vec4(axisZ.x, -axisZ.x, axisZ.y, -axisZ.y);
	vec4 faceReach = reach * sqrt(faceX * faceX + faceY * faceY + faceZ * faceZ);
	float eyeReach = reach * length(vec3(axisX.w, axisY.w, axisZ.w));

	// The margin. A NaN or an infinity anywhere makes the comparisons false, so such a particle is never culled.
	float worldScale = dot(abs(pos), vec3(1.0)) + dot(abs(ViewMatrix[3].xyz), vec3(1.0));
	float projectionScale = dot(abs(ProjectionMatrix[0]) + abs(ProjectionMatrix[1]) + abs(ProjectionMatrix[2]), vec4(1.0));
	float magnitude = abs(centre.w) + abs(centre.x) + abs(centre.y) + projectionScale * worldScale;
	if (any(lessThan(face + faceReach + kParticleCullMargin * (vec4(magnitude) + faceReach), vec4(0.0))))
		return true;
	return centre.w + eyeReach + kParticleCullMargin * (magnitude + eyeReach) < 0.0;
}

// Where one corner of the quad goes, in eye space.
//   orient 0  CAMERA-FACING, offset in eye space. Each eye has its own view
//             matrix, so stereo is correct, and any scale/mirror baked into the
//             view matrix is already applied to the centre.
//   orient 1  VELOCITY-STRETCHED: the long axis follows the velocity projected
//             onto the view plane, so a spark flying at the eye stays short.
//   orient 2  WORLD-FLAT: a quad whose normal is faceDir (the initial velocity),
//             so a flake faces the way it was thrown.
// `c` is the corner in quad units, already turned if the particle spins.
vec4 ParticleEyePosition(vec3 pos, vec3 vel, vec3 faceDir, vec2 c, float halfSize, int orient, float stretch)
{
	vec3 up = vec3(0.0, 1.0, 0.0);

	if (orient == 2)
	{
		vec3 n = faceDir;
		float nl = length(n);
		n = (nl > 1e-5) ? n / nl : up;
		vec3 seedAxis = (abs(n.y) < 0.9) ? up : vec3(1.0, 0.0, 0.0);
		vec3 tx = normalize(cross(seedAxis, n));
		vec3 ty = cross(n, tx);
		return ViewMatrix * vec4(pos + (tx * c.x + ty * c.y) * halfSize, 1.0);
	}

	vec4 eyePos = ViewMatrix * vec4(pos, 1.0);
	vec2 offs = c * halfSize;

	if (orient == 1)
	{
		vec3 ve = mat3(ViewMatrix) * vel;
		float sl = length(ve.xy);
		if (sl > 1e-3)
		{
			vec2 along = ve.xy / sl;
			vec2 across = vec2(-along.y, along.x);
			float halfLen = halfSize + sl * stretch * uGpuParticleParams.z;
			offs = along * (c.x * halfLen) + across * (c.y * halfSize);
		}
	}
	eyePos.xy += offs;
	return eyePos;
}

void EmitParticle(vec4 eyePos, vec2 corner, vec3 rgb)
{
	gl_Position = ProjectionMatrix * eyePos;

#ifdef VULKAN_COORDINATE_SYSTEM
	gl_Position.z = (gl_Position.z + gl_Position.w) / 2.0;
#endif

	vParticleColor = vec4(rgb, 1.0);
	vParticleCorner = corner;
}

// [2b] A stage 1 record, drawn with the stage 1 maths. Temporary: it goes with
// r_gpuparticles_legacy once the A/B has shown the two paths look the same.
void DrawLegacyParticle(GpuParticle part, int corner, float age, float life)
{
	float t = age / life;
	float diameter = min(mix(part.d.x, part.d.y, t) * uGpuParticleParams.x, uGpuParticleParams.y);
	if (diameter <= 0.0)
	{
		CollapseParticle();
		return;
	}
	float halfSize = 0.5 * diameter;

	// Closed-form motion with linear drag. k is clamped so drag 0 needs no
	// branch: (1 - e^-ka)/k tends to a as k tends to 0.
	float k = max(part.d.w, 1e-4);
	float decay = exp(-k * age);
	vec3 up = vec3(0.0, 1.0, 0.0);
	vec3 pos = part.a.xyz + part.b.xyz * ((1.0 - decay) / k) - up * (part.d.z * 0.5 * age * age);
	vec3 vel = part.b.xyz * decay - up * (part.d.z * age);

	vec2 c = kParticleCorners[corner];
	int orient = int(part.e.x + 16.5);
	vec4 eyePos = ParticleEyePosition(pos, vel, part.b.xyz, c, halfSize, orient, part.e.y);

	float fade = 1.0 - smoothstep(0.6, 1.0, t);
	EmitParticle(eyePos, c, part.c.rgb * (part.c.w * uGpuParticleParams.w * fade));
	vParticleFlipbook = vec4(-1.0, -1.0, 0.0, -1.0);	// [2c] stage 1 records have no texture
	vParticleBody = vec4(0.0);	// [2d] nor a body: purely additive
	vParticleSoft = -1.0;
	vParticleLife = vec4(0.0);	// [LOOKS] nor a look
	vParticleLightDir = vec4(0.0);
}

// [PARTICLEDEFS] Key i's colour, 0..1. Stored as 0xRRGGBB in a float, which holds
// it exactly (below 2^24), so a plain conversion recovers the integer.
vec3 ParticleKeyColor(int defSlot, int keyIndex)
{
	uint rgbBits = uint(particleDefinitions[defSlot].keyColor[keyIndex / 4][keyIndex % 4]);
	return vec3(float((rgbBits >> 16u) & 255u), float((rgbBits >> 8u) & 255u), float(rgbBits & 255u)) / 255.0;
}

// [PARTICLEDEFS] A unit normal from its octahedral encoding (shader z is the pole).
// Matches the encoder in FLevelLocals::SpawnParticles.
vec3 OctahedralDecode(vec2 e)
{
	vec3 n = vec3(e.x, e.y, 1.0 - abs(e.x) - abs(e.y));
	float fold = max(-n.z, 0.0);
	n.x += (n.x >= 0.0) ? -fold : fold;
	n.y += (n.y >= 0.0) ? -fold : fold;
	return normalize(n);
}

// [2c] Which flipbook frames a particle shows at `age` seconds (life fraction `t`),
// as vParticleFlipbook: x this frame's atlas layer, y the next frame's, z how far
// into the next, w the definition slot. Untextured definitions give x = -1.
//   loop  the frame is age x fps, wrapping; the last frame blends into the first.
//   once  the frames are spread over the life, t x frames; the last frame holds.
// The definition's flipbook: x first atlas layer (-1 none), y frames, z fps, w 0 loop / 1 once.
vec4 ParticleFlipbookFrames(int defSlot, float age, float t)
{
	vec4 flip = particleDefinitions[defSlot].flipbook;
	if (flip.x < -0.5)
		return vec4(-1.0, -1.0, 0.0, float(defSlot));

	float frameCount = max(floor(flip.y + 0.5), 1.0);
	float framePosition;
	float frameA;
	float frameB;
	if (flip.w > 0.5)
	{
		framePosition = clamp(t * frameCount, 0.0, frameCount - 1.0);
		frameA = floor(framePosition);
		frameB = min(frameA + 1.0, frameCount - 1.0);
	}
	else
	{
		framePosition = mod(max(age, 0.0) * flip.z, frameCount);
		frameA = min(floor(framePosition), frameCount - 1.0);
		frameB = frameA + 1.0;
		if (frameB > frameCount - 0.5)
			frameB = 0.0;
	}
	float frameBlend = clamp(framePosition - frameA, 0.0, 1.0);
	float firstLayer = floor(flip.x + 0.5);
	return vec4(firstLayer + frameA, firstLayer + frameB, frameBlend, float(defSlot));
}

// [2d] The light at a particle's centre: the sector light it was spawned in (record
// d.z) plus every view light whose radius reaches it, each attenuated the way
// surfaces and sprites attenuate a dynamic light -- 1 - distance / radius, times a
// spot's cone, smoothstep(cos outer, cos inner, cos angle) as main.fp's
// spotLightAttenuation -- and clamped as surfaces clamp sector plus dynamic light,
// 0..1.4. Subtractive lights carry a negative colour. No shadow map test.
//
// [LOOKS] With `wantDirection` (a lit dust look), the same loop also sums each light's
// direction from the particle, weighted by the light it gives here -- its colour's luminance x
// the attenuation above, so a subtractive light counts against its direction -- into
// directionSum.xyz, and those weights' magnitudes into directionSum.w. Without it the loop does
// exactly what it did before.
vec3 ParticleViewLight(vec3 pos, float ambient, bool wantDirection, inout vec4 directionSum)
{
	vec3 light = vec3(ambient);
	int count = clamp(int(viewLightInfo.x + 0.5), 0, kViewLightCapacity);
	for (int i = 0; i < count; i++)
	{
		vec3 toLight = viewLights[i].origin.xyz - pos;
		float radius = viewLights[i].origin.w;
		float distSquared = dot(toLight, toLight);
		if (radius <= 0.0 || distSquared >= radius * radius)
			continue;
		float dist = sqrt(distSquared);
		float attenuation = 1.0 - dist / radius;
		vec3 lightDirection = toLight / max(dist, 1e-4);
		attenuation *= smoothstep(viewLights[i].spotCone.x, viewLights[i].spotCone.y, dot(lightDirection, viewLights[i].spotDirection.xyz));
		light += viewLights[i].color.rgb * attenuation;
		if (wantDirection)
		{
			float lightWeight = dot(viewLights[i].color.rgb, vec3(0.2126, 0.7152, 0.0722)) * attenuation;
			directionSum += vec4(lightDirection * lightWeight, abs(lightWeight));
		}
	}
#ifdef EFFECT_LIGHTS
	// [PARTICLELIGHTS] And the effect lights of its bin, before the clamp, as a dynamic light adds. They do not join a dust look's
	// light direction, which stays the view lights'.
	// [PARTICLECULL] E11 LIGHT LOD: times ParticleEffectLightShare. At 1 -- every particle while the distance is 0 -- this is the
	// statement from before E11; at 0 the bin is not read at all.
	float effectLightShare = ParticleEffectLightShare(pos);
	if (effectLightShare >= 1.0)
		light += EffectLightsAtParticle(pos);
	else if (effectLightShare > 0.0)
		light += EffectLightsAtParticle(pos) * effectLightShare;
#endif
	return clamp(light, vec3(0.0), vec3(1.4));
}

// [LOOKS] The view lights' summed direction (ParticleViewLight's directionSum, world space) in the
// quad's own axes, for gpuparticles.fp's slope lighting: x and y along the corner coordinates
// vParticleCorner carries, turned with the quad by its spin, z out of the quad toward the eye. The
// axes are ParticleEyePosition's for each orient. w: how much of the particle's light comes from that
// direction -- the summed direction's length over everything lighting it (the sector light at spawn
// plus each light's weight) -- times `lit`. Per eye, like the quad itself.
vec4 ParticleLightInQuad(vec4 directionSum, float ambient, float lit, vec3 pos, vec3 vel, vec3 faceDir, float spinAngle, int orient)
{
	float directional = length(directionSum.xyz);
	if (directional <= 1e-5)
		return vec4(0.0);

	mat3 toEye = mat3(ViewMatrix);
	vec3 lightEye = toEye * (directionSum.xyz / directional);
	vec3 axisX = vec3(1.0, 0.0, 0.0);
	vec3 axisY = vec3(0.0, 1.0, 0.0);
	vec3 axisZ = vec3(0.0, 0.0, 1.0);
	if (orient == 2)
	{
		// FLAKE: the world-flat quad's axes, its face turned toward the eye.
		vec3 up = vec3(0.0, 1.0, 0.0);
		vec3 n = faceDir;
		float nl = length(n);
		n = (nl > 1e-5) ? n / nl : up;
		vec3 seedAxis = (abs(n.y) < 0.9) ? up : vec3(1.0, 0.0, 0.0);
		vec3 tx = normalize(cross(seedAxis, n));
		axisX = toEye * tx;
		axisY = toEye * cross(n, tx);
		axisZ = toEye * n;
		if (dot(axisZ, (ViewMatrix * vec4(pos, 1.0)).xyz) > 0.0)
			axisZ = -axisZ;
	}
	else if (orient == 1)
	{
		// STREAK: the long axis along the velocity on the view plane.
		vec3 ve = toEye * vel;
		float sl = length(ve.xy);
		if (sl > 1e-3)
		{
			axisX = vec3(ve.xy / sl, 0.0);
			axisY = vec3(-axisX.y, axisX.x, 0.0);
		}
	}
	if (spinAngle != 0.0)
	{
		// The corner offsets turn by the spin (DrawDefinedParticle): corner (1, 0) lands on
		// axisX cos + axisY sin, corner (0, 1) on axisY cos - axisX sin.
		float ca = cos(spinAngle);
		float sa = sin(spinAngle);
		vec3 turnedX = axisX * ca + axisY * sa;
		axisY = axisY * ca - axisX * sa;
		axisX = turnedX;
	}

	vec3 inQuad = vec3(dot(lightEye, axisX), dot(lightEye, axisY), dot(lightEye, axisZ));
	float inQuadLength = length(inQuad);
	if (inQuadLength <= 1e-5)
		return vec4(0.0);
	float directionalShare = clamp(directional / max(ambient + directionSum.w, 1e-4), 0.0, 1.0) * lit;
	return vec4(inQuad / inQuadLength, directionalShare);
}

#ifdef LEVEL_FIELD_COLLISION
// [LEVELFIELD] #8 PARTICLES THAT COLLIDE WITH THE WHOLE LEVEL ("Engine docs/COLLISION_DEBRIS_MESH_PLAN.md" 8,
// "Engine docs/COLLISION_8_IMPL_NOTES.md"). Compiled only with LEVEL_FIELD_COLLISION, which vk_shader.cpp defines
// for this effect's vertex programs; without it this lump is exactly what it was before #8.
//
// A `collide = level` definition -- or a `collide = plane` one while r_particlecollision_test is on -- is kept out
// of the level by a signed distance field around the eye, built from the level's CURRENT floors, ceilings and
// walls (hw_levelfield.cpp) and baked on the GPU (vk_levelfield.cpp, shaders/compute/field_bake.comp). In the
// fixed set (vk_descriptorset.cpp), declared only here:
//   binding 5  the fine level, 6 the coarse one: rg16f volumes, r the signed distance in map units (negative in
//              solid, clamped to the level's band), g 1 where baked. A texel holds the world cell congruent to it
//              modulo the volume's size, so a sample is trusted only inside its level's window.
//   binding 9  the header, 3 x 1: [0] the fine window (xyz its first world cell, w the cell size in map units,
//              0 = no level), [1] the coarse window, [2] x 1 = usable, y 1 = plane definitions collide too, z the
//              fine band, w the coarse band.
// Header and texels are written by commands in one stream, so they always agree. While the field does not exist
// the bindings hold stand-ins that say "no level", and every particle keeps F4's plane.
//
// Positions in the field are Doom axes (x, y horizontal, z up): a shader position p is p.xzy there.
//
// WHAT HAPPENS -- stateless, a pure function of the record, the age and the field:
//   - THE PATH SO FAR (LevelFieldMarch): the first lattice sample moving into a floor LANDS the particle, and it
//     skids at that height from then on; the first moving into a wall deeper than its kill depth KILLS it, and
//     it stays gone however far its path goes (review D7: pushing it out would pop it through to the far side).
//   - NOW (LevelFieldContact): closer to a surface than its radius it is pushed out along the field's normal and
//     loses the velocity into the surface, so a streak slides along it; deeper than the kill depth into a wall it
//     fades out over the next kill depth. A floor always holds it up.
//   - Where the field has no answer (outside both windows, not baked yet) the particle takes F4's plane.
layout(set = 0, binding = 5) uniform sampler3D LevelFieldFine;
layout(set = 0, binding = 6) uniform sampler3D LevelFieldCoarse;
layout(set = 0, binding = 9) uniform sampler2D LevelFieldHeader;

// At most this many samples of the path so far, per vertex; and of a landed particle's skid after it.
const int kLevelFieldMarchSteps = 24;
const int kLevelFieldSkidSteps = 24;
// A skid is checked this far (map units) above the height it slides at: the floor right under it would hold every step
// to the lattice spacing, while a wall it slides into stands above it too. A step lower than this is not a wall.
const float kLevelFieldSkidRaise = 12.0;
// A surface whose normal's up part is above this is a floor: landed on and skidded along, never faded into.
const float kLevelFieldFloorUp = 0.7;
// A sample whose |distance| reaches this share of its level's band is clamped: its magnitude is only a bound.
const float kLevelFieldClampShare = 0.9;
// What LevelFieldMarch found on the path so far.
const int kLevelFieldPathClear = 0;
const int kLevelFieldPathLanded = 1;
const int kLevelFieldPathKilled = 2;

// The header and the volumes' sizes, read once per vertex by LevelFieldCollide.
vec4 gLevelFieldWindow[2];
vec4 gLevelFieldParams;
vec3 gLevelFieldSize[2];

// One level's signed distance at doomPosition, map units: false when that level has no baked answer there -- no
// window, the trilinear footprint (grown by `margin` cells) not wholly inside the window (beyond it the torus
// wraps to a different world cell), or a texel of it not baked yet.
bool LevelFieldLevelDistance(int level, vec3 doomPosition, float margin, out float fieldDistance)
{
	fieldDistance = 0.0;
	vec4 window = gLevelFieldWindow[level];
	if (window.w <= 0.0)
		return false;
	vec3 cells = doomPosition / window.w;
	vec3 inWindow = cells - window.xyz;
	vec3 size = gLevelFieldSize[level];
	if (any(lessThan(inWindow, vec3(0.5 + margin))) || any(greaterThan(inWindow, size - vec3(0.5 + margin))))
		return false;
	vec4 texel = (level == 0) ? textureLod(LevelFieldFine, cells / size, 0.0) : textureLod(LevelFieldCoarse, cells / size, 0.0);
	if (texel.g < 0.999)
		return false;
	fieldDistance = texel.r;
	return true;
}

// The field's signed distance at doomPosition, and the level to take its normal on (-1: no answer). The fine level
// answers where it is not clamped; the coarse one further out, never overruling the fine level's sign.
float LevelFieldDistance(vec3 doomPosition, out int level)
{
	float fineDistance;
	float coarseDistance;
	bool fine = LevelFieldLevelDistance(0, doomPosition, 0.5, fineDistance);
	if (fine && abs(fineDistance) < gLevelFieldParams.z * kLevelFieldClampShare)
	{
		level = 0;
		return fineDistance;
	}
	bool coarse = LevelFieldLevelDistance(1, doomPosition, 0.5, coarseDistance);
	if (fine)
	{
		// Clamped on the fine level: a bound. The coarse level may know how far it really is.
		level = coarse ? 1 : 0;
		if (coarse && (coarseDistance < 0.0) == (fineDistance < 0.0))
			return (fineDistance < 0.0) ? min(fineDistance, coarseDistance) : max(fineDistance, coarseDistance);
		return fineDistance;
	}
	level = coarse ? 1 : -1;
	return coarse ? coarseDistance : 0.0;
}

// The field's outward normal at doomPosition on one level (Doom axes), from four samples on a tetrahedron half a
// cell out. False when a sample has no answer or the field is flat there (inside a clamped region).
bool LevelFieldNormal(int level, vec3 doomPosition, out vec3 normal)
{
	normal = vec3(0.0, 0.0, 1.0);
	if (level < 0)
		return false;
	float h = 0.5 * gLevelFieldWindow[level].w;
	const vec3 k0 = vec3(1.0, -1.0, -1.0);
	const vec3 k1 = vec3(-1.0, -1.0, 1.0);
	const vec3 k2 = vec3(-1.0, 1.0, -1.0);
	const vec3 k3 = vec3(1.0, 1.0, 1.0);
	float d0;
	float d1;
	float d2;
	float d3;
	if (!LevelFieldLevelDistance(level, doomPosition + k0 * h, 0.0, d0) ||
		!LevelFieldLevelDistance(level, doomPosition + k1 * h, 0.0, d1) ||
		!LevelFieldLevelDistance(level, doomPosition + k2 * h, 0.0, d2) ||
		!LevelFieldLevelDistance(level, doomPosition + k3 * h, 0.0, d3))
		return false;
	vec3 gradient = k0 * d0 + k1 * d1 + k2 * d2 + k3 * d3;
	float gradientLength = length(gradient);
	// A distance field's gradient is 1 long, so this sum is about 4h long; a flat one is not a surface.
	if (gradientLength < h)
		return false;
	normal = gradient / gradientLength;
	return true;
}

// The closed-form path (DrawDefinedParticle's formulas) at `age`, shader space.
vec3 LevelFieldPathAt(GpuParticle part, float age, float gravity, float k)
{
	return part.a.xyz + part.b.xyz * ((1.0 - exp(-k * age)) / k) - vec3(0.0, gravity * 0.5 * age * age, 0.0);
}

vec3 LevelFieldVelocityAt(GpuParticle part, float age, float gravity, float k)
{
	return part.b.xyz * exp(-k * age) - vec3(0.0, gravity * age, 0.0);
}

// How far the closed-form path can have gone by `age`, at most: no point of it moves faster than speed + fall x age
// (|initial velocity| plus |gravity| x time; drag only slows it). And its inverse, the age at which that bound reaches
// `reach` (the stable root, right for no gravity too).
float LevelFieldReach(float speed, float fall, float age)
{
	return speed * age + 0.5 * fall * age * age;
}

float LevelFieldAgeAt(float speed, float fall, float reach)
{
	return 2.0 * reach / (speed + sqrt(speed * speed + 2.0 * fall * reach));
}

// THE SKID SO FAR. After landing at landedAge the particle slides at landedHeight along a straight line (gravity is
// vertical and drag is linear, so its horizontal path never turns), horizontal distance
// s(t) = |b.xz| (1 - e^-kt) / k from its spawn. That line is sampled from the landing on, at kLevelFieldSkidRaise
// above the skid, at points spaced evenly in s -- a function of the record and the landing alone, so a later frame
// never changes its mind -- sphere-traced (a raised point with distance d cannot be deeper than killDepth in a wall
// until d + killDepth further on). True when the skid has gone into a wall deeper than killDepth by `age`: it is
// gone, and never slides out on the far side.
bool LevelFieldSkidKilled(GpuParticle part, float age, float k, float spacing, float killDepth, float landedAge, float landedHeight)
{
	float horizontalSpeed = length(part.b.xz);
	if (horizontalSpeed < 1.0e-3)
		return false;
	vec2 direction = part.b.xz / horizontalSpeed;
	float skidNow = horizontalSpeed * (1.0 - exp(-k * age)) / k;
	float skid = horizontalSpeed * (1.0 - exp(-k * landedAge)) / k + spacing;
	float raised = landedHeight + kLevelFieldSkidRaise;
	for (int i = 0; i < kLevelFieldSkidSteps; i++)
	{
		if (skid > skidNow)
			return false;
		vec2 place = part.a.xz + direction * skid;
		int level;
		float d = LevelFieldDistance(vec3(place.x, place.y, raised), level);
		if (level < 0)
			return false;
		if (d < -killDepth)
			return true;
		skid += spacing * max(1.0, ceil((d + killDepth) / spacing));
	}
	return false;
}

// THE PATH SO FAR. The path is sampled at lattice points spaced evenly in REACH -- the bound above, so neighbouring
// samples are never further apart on the path than the spacing, and the lattice is a function of the record alone:
// a later frame looks at the same points and never changes its mind -- sphere-traced through open air (the reach
// skipped is exactly the room the field says there is), at most kLevelFieldMarchSteps samples, up to `age`. The first
// sample closer than the radius that moves INTO a floor lands the particle (landedAge; landedHeight, its radius above
// that floor); one that moves into a wall deeper than killDepth kills it (review D7). A sample with no answer from
// the field ends the look.
int LevelFieldMarch(GpuParticle part, float age, float life, float gravity, float k, float radius, float killDepth, out float landedAge, out float landedHeight)
{
	landedAge = 0.0;
	landedHeight = 0.0;
	float speed = length(part.b.xyz);
	float fall = abs(gravity);
	if (speed + fall * life < 1.0e-3)
		return kLevelFieldPathClear;	// it never moves: the current sample says everything
	float spacing = max(min(radius, killDepth), 1.0);
	float reachNow = LevelFieldReach(speed, fall, age);
	float lattice = 0.0;
	for (int i = 0; i < kLevelFieldMarchSteps; i++)
	{
		float reach = lattice * spacing;
		if (reach > reachNow)
			break;
		float pathAge = LevelFieldAgeAt(speed, fall, reach);
		vec3 position = LevelFieldPathAt(part, pathAge, gravity, k);
		int level;
		float d = LevelFieldDistance(position.xzy, level);
		if (level < 0)
			break;
		if (d >= radius)
		{
			// Nothing is within d of here: the path cannot come within its radius of a surface before it has
			// gone d - radius further.
			lattice = max(lattice + 1.0, ceil((reach + d - radius) / spacing));
			continue;
		}
		vec3 normal;
		bool known = LevelFieldNormal(level, position.xzy, normal);
		bool into = dot(LevelFieldVelocityAt(part, pathAge, gravity, k).xzy, normal) < 0.0;
		if (known && normal.z > kLevelFieldFloorUp)
		{
			if (into)
			{
				landedAge = pathAge;
				landedHeight = position.y + (radius - d) / normal.z;
				return LevelFieldSkidKilled(part, age, k, spacing, killDepth, landedAge, landedHeight) ? kLevelFieldPathKilled : kLevelFieldPathLanded;
			}
		}
		else if (d < -killDepth && (into || !known))
		{
			return kLevelFieldPathKilled;
		}
		lattice += 1.0;
	}
	return kLevelFieldPathClear;
}

// NOW, at the drawn position: closer to a surface than the radius, pushed out along the field's normal to the
// radius, and the velocity into the surface taken off (a streak turns along it). Into a wall deeper than killDepth
// it fades out over the next killDepth; a floor always holds it up. Returns the fade (1 = untouched), or -1 when the
// field has no answer here.
float LevelFieldContact(inout vec3 position, inout vec3 velocity, float radius, float killDepth)
{
	int level;
	float d = LevelFieldDistance(position.xzy, level);
	if (level < 0)
		return -1.0;
	if (d >= radius)
		return 1.0;
	vec3 normal;
	if (!LevelFieldNormal(level, position.xzy, normal))
		return (d >= -killDepth) ? 1.0 : 0.0;
	vec3 outward = normal.xzy;
	position += outward * (radius - d);
	velocity -= outward * min(dot(velocity, outward), 0.0);
	if (normal.z > kLevelFieldFloorUp || d >= -killDepth)
		return 1.0;
	return 1.0 - smoothstep(killDepth, 2.0 * killDepth, -d);
}

// The whole of #8 for one vertex of a stage 2 record. False when this particle does not collide with the level
// here -- its definition does not ask, the field is not usable, or the field has no answer at the drawn position
// and the path never landed -- and the caller's F4 plane runs exactly as before. True: pos and vel are this
// frame's, and fieldFade multiplies the particle (0 = gone). The radius is F4's, half the drawn size; the kill
// depth that radius, but at least 1 map unit (the field's own precision) and at most 2 (so an 8-unit door still
// holds a large particle).
bool LevelFieldCollide(GpuParticle part, int defSlot, float age, float life, float gravity, float k, float halfSize, inout vec3 pos, inout vec3 vel, out float fieldFade)
{
	fieldFade = 1.0;
	float collide = particleDefinitions[defSlot].look.z;
	if (collide < 0.5)
		return false;
	gLevelFieldParams = texelFetch(LevelFieldHeader, ivec2(2, 0), 0);
	if (gLevelFieldParams.x < 0.5 || (collide < 1.5 && gLevelFieldParams.y < 0.5))
		return false;
	gLevelFieldWindow[0] = texelFetch(LevelFieldHeader, ivec2(0, 0), 0);
	gLevelFieldWindow[1] = texelFetch(LevelFieldHeader, ivec2(1, 0), 0);
	gLevelFieldSize[0] = vec3(textureSize(LevelFieldFine, 0));
	gLevelFieldSize[1] = vec3(textureSize(LevelFieldCoarse, 0));

	float radius = halfSize;
	float killDepth = clamp(radius, 1.0, 2.0);
	float landedAge;
	float landedHeight;
	int path = LevelFieldMarch(part, age, life, gravity, k, radius, killDepth, landedAge, landedHeight);
	if (path == kLevelFieldPathKilled)
	{
		fieldFade = 0.0;
		return true;
	}
	bool landed = (path == kLevelFieldPathLanded);
	if (landed && pos.y < landedHeight)
	{
		// Skidding: the closed-form path goes on below the floor; the particle stays on top of it.
		pos.y = landedHeight;
		vel.y = 0.0;
	}
	float contact = LevelFieldContact(pos, vel, radius, killDepth);
	if (contact < 0.0)
		return landed;	// no answer here: a landed particle keeps skidding at its height, any other takes the plane
	fieldFade = contact;
	return true;
}
#endif
// [PARTICLEDEFS] A stage 2 record: everything about its look from its definition.
void DrawDefinedParticle(GpuParticle part, int corner, float age, float life)
{
	int defSlot = clamp(int(part.d.x + 0.5), 0, kParticleDefinitionSlots - 1);
	float t = age / life;

	// THE RAMPS. Size, alpha, emissive and colour share the definition's time
	// keys: find the key at or before t and the fraction to the next. Held flat
	// before the first key and after the last.
	int keyCount = clamp(int(particleDefinitions[defSlot].motion.w + 0.5), 1, 8);
	int k0 = 0;
	int k1 = 0;
	float f = 0.0;
	if (keyCount > 1 && t > particleDefinitions[defSlot].key[0].x)
	{
		k0 = keyCount - 1;
		k1 = k0;
		for (int i = 1; i < keyCount; i++)
		{
			if (t < particleDefinitions[defSlot].key[i].x)
			{
				k0 = i - 1;
				k1 = i;
				float t0 = particleDefinitions[defSlot].key[k0].x;
				f = (t - t0) / (particleDefinitions[defSlot].key[k1].x - t0);
				break;
			}
		}
	}
	vec4 key0 = particleDefinitions[defSlot].key[k0];
	vec4 key1 = particleDefinitions[defSlot].key[k1];

	// Size through mix(), exactly as stage 1 interpolated it, so an inline
	// definition (keys at 0 and 1, so f == t) gives stage 1's size. Emissive and
	// colour as a + (b - a) * f, which is exact where both keys agree -- an inline
	// definition's constant 1 and white -- so its brightness is stage 1's too.
	// Alpha (key.z) is the [2d] body below.
	float rampSize = mix(key0.y, key1.y, f);
	float emissive = key0.w + (key1.w - key0.w) * f;
	vec3 color0 = ParticleKeyColor(defSlot, k0);
	vec3 rampColor = color0 + (ParticleKeyColor(defSlot, k1) - color0) * f;

	// The size cap: the definition's own, if it has one, never above the cvar.
	float cap = uGpuParticleParams.y;
	if (particleDefinitions[defSlot].motion.z > 0.0)
		cap = min(particleDefinitions[defSlot].motion.z, cap);
	float diameter = min(rampSize * part.d.y * uGpuParticleParams.x, cap);
	if (diameter <= 0.0)
	{
		CollapseParticle();
		return;
	}
	float halfSize = 0.5 * diameter;

	// Stage 1's closed-form motion, with the definition's gravity and drag.
	float gravity = particleDefinitions[defSlot].motion.x;
	float k = max(particleDefinitions[defSlot].motion.y, 1e-4);
	float decay = exp(-k * age);
	vec3 up = vec3(0.0, 1.0, 0.0);
	vec3 pos = part.a.xyz + part.b.xyz * ((1.0 - decay) / k) - up * (gravity * 0.5 * age * age);
	vec3 vel = part.b.xyz * decay - up * (gravity * age);

	// COLLISION (FLAME_ENGINE_PLAN F4), only for `collide = plane` definitions.
	// The emission's plane: closer than the particle's radius, it is pushed out
	// along the normal and slides, its velocity (which orients a streak) losing the
	// normal part. The floor: below floor + radius it is clamped and skids.
#ifdef LEVEL_FIELD_COLLISION
	// [LEVELFIELD] A `collide = level` particle is kept out of the whole level by the field first; where the field
	// has no answer it falls back to the plane below, as every `collide = plane` particle does.
	float levelFieldFade = 1.0;
	bool levelFieldHandled = LevelFieldCollide(part, defSlot, age, life, gravity, k, halfSize, pos, vel, levelFieldFade);
	if (levelFieldFade <= 0.0)
	{
		CollapseParticle();
		return;
	}
	if (!levelFieldHandled && particleDefinitions[defSlot].look.z > 0.5)
#else
	if (particleDefinitions[defSlot].look.z > 0.5)
#endif
	{
		if (part.e.x < 1.5)
		{
			vec3 n = OctahedralDecode(part.e.xy);
			float d = dot(pos, n) - part.e.z;
			if (d < halfSize)
			{
				pos += n * (halfSize - d);
				vel -= n * dot(vel, n);
			}
		}
		if (part.e.w > -32767.0 && pos.y < part.e.w + halfSize)
		{
			pos.y = part.e.w + halfSize;
			vel.y = 0.0;
		}
	}

	// SPIN: degrees a second picked between the definition's min and max by the
	// particle's seed, turning the quad's corners (a streak keeps its velocity's
	// direction). vParticleCorner stays unturned, so a texture turns with the quad.
	vec2 c = kParticleCorners[corner];
	vec2 offsetCorner = c;
	int orient = int(particleDefinitions[defSlot].shape.x + 0.5);
	float spinMin = particleDefinitions[defSlot].shape.z;
	float spinMax = particleDefinitions[defSlot].shape.w;
	if (orient != 1 && (spinMin != 0.0 || spinMax != 0.0))
	{
		float angle = radians(mix(spinMin, spinMax, part.d.w)) * age;
		float ca = cos(angle);
		float sa = sin(angle);
		offsetCorner = vec2(c.x * ca - c.y * sa, c.x * sa + c.y * ca);
	}
	// [PARTICLECULL] E11: wholly outside this view -- nothing of it could be drawn -- it collapses here, after the collision that
	// placed it and before its lights, flipbook and look (ParticleOutsideView). With r_gpuparticles_cull off it goes on as before.
	if (uGpuParticleParams2.w > 0.0 && ParticleOutsideView(pos, vel, halfSize, orient, particleDefinitions[defSlot].shape.y))
	{
		CollapseParticle();
		return;
	}
	vec4 eyePos = ParticleEyePosition(pos, vel, part.b.xyz, offsetCorner, halfSize, orient, particleDefinitions[defSlot].shape.y);

	// Flag 1: stage 1's fade over the last 40% of life. Every inline definition has
	// it; a lump asks with `fade = smooth`.
	float fade = 1.0;
	if ((int(particleDefinitions[defSlot].look.w + 0.5) & 1) != 0)
		fade = 1.0 - smoothstep(0.6, 1.0, t);
#ifdef LEVEL_FIELD_COLLISION
	fade *= levelFieldFade;	// [LEVELFIELD] fading out inside a wall
#endif

	EmitParticle(eyePos, c, part.c.rgb * rampColor * (part.c.w * emissive * uGpuParticleParams.w * fade));
	vParticleFlipbook = ParticleFlipbookFrames(defSlot, age, t);	// [2c]

	// [2d] THE BODY: what hides the scene behind the particle, and its colour. The
	// alpha ramp as the emissive ramp is interpolated, times the same fade. Lit by
	// the sector light at spawn and the view lights, in proportion to the
	// definition's `lit` (0 = its colour as written). The tint applies; the
	// intensity scale and r_gpuparticles_intensity do not -- they brighten glow.
	// Only gpuparticles.fp's premultiplied output reads the body, so the light loop
	// runs only under that blend, and only while this particle is lit and not
	// transparent.
	float alpha = clamp(key0.z + (key1.z - key0.z) * f, 0.0, 1.0) * fade;
	float lit = clamp(particleDefinitions[defSlot].look.x, 0.0, 1.0);
	vec3 bodyLight = vec3(1.0);
	// [LOOKS] Whether this particle is drawn with its definition's look, and whether the light loop
	// below also sums the lights' direction for it: only a dust (later smoke) look, at quality 2 or
	// more -- and the loop itself still runs only for a lit, occluding particle under the
	// premultiplied blend.
	int lookKind = int(ParticleLookShape(defSlot).x + 0.5);
	bool drawLook = lookKind != 0 && uGpuParticleParams2.z > 0.5;
	bool wantLightDirection = drawLook && (lookKind == kLookDust || lookKind == kLookSmoke) && uGpuParticleParams2.z > 1.5;
	vec4 lightDirectionSum = vec4(0.0);
	if (uGpuParticleParams2.y > 0.5 && alpha > 0.0 && lit > 0.0)
		bodyLight = mix(vec3(1.0), ParticleViewLight(pos, part.d.z, wantLightDirection, lightDirectionSum), lit);
	vParticleBody = vec4(part.c.rgb * rampColor * bodyLight, alpha);
	vParticleSoft = particleDefinitions[defSlot].look.y;

	// [LOOKS] What gpuparticles.fp generates the look from; zeros for no look.
	vParticleLife = drawLook ? vec4(t, age, part.d.w, diameter) : vec4(0.0);
	vParticleLightDir = vec4(0.0);
	if (wantLightDirection && lightDirectionSum.w > 0.0)
	{
		// The spin the corner offsets were turned by above (a streak does not spin).
		float lookSpinAngle = (orient != 1) ? radians(mix(spinMin, spinMax, part.d.w)) * age : 0.0;
		vParticleLightDir = ParticleLightInQuad(lightDirectionSum, part.d.z, lit, pos, vel, part.b.xyz, lookSpinAngle, orient);
	}
}

// [DEBRISPOOL] DEBRIS THAT STAYS ("Engine docs/COLLISION_DEBRIS_MESH_PLAN.md" #9, "Engine docs/DEBRIS_9_IMPL_NOTES.md").
// A piece of the debris pool is simulated on the GPU (shaders/compute/debris_step.comp) instead of worked out from a
// record: it bounces, comes to rest and stays. Its billboard is drawn here, from set 1 binding 10 (the pieces) and 11
// (the debris definitions), declared only in this lump and meshparticles.vp. A piece keeps the ring's own record as its
// spawn, so DrawPooledParticle is DrawDefinedParticle's look, token for token, with three differences:
//   - THE MOTION comes from the pool, blended between its last two steps (the actor convention), and no collision is
//     applied here: the step did it;
//   - THE SPIN is the angle of its turn about the view axis, which the step slows on contact and stops at rest;
//   - THE CLOCK: the ramps run over its life and hold their last key after it; a piece that never rests is gone when
//     its life ends; one that rests fades over its restfade at the end of its rest (DebrisDrawFade), in place of
//     `fade = smooth`.
// Nothing here runs for a ring vertex: main() comes here only for the pool's quads (aParticle.w = 1).
//
// hw_debrisframe.h DebrisPieceGpu, 176 bytes: the ring record, then position (w state 0 free, 1 flying, 2 resting),
// previous (w the level time of position), velocity (w its rest start, -1 none), turn, previousTurn, spin.
struct DebrisPiece { GpuParticle spawn; vec4 position; vec4 previous; vec4 velocity; vec4 turn; vec4 previousTurn; vec4 spin; };
layout(set = 1, binding = 10, std430) buffer readonly DebrisPoolSSO
{
	DebrisPiece debrisPieces[];
};
// hw_debrisframe.h DebrisDefinitionGpu, 80 bytes: physics (x restitution, y friction, z rest life, w rest fade), motion,
// body, bounds; then the pool mesh instance list (meshparticles.vp reads it).
struct DebrisDefinition { vec4 physics; vec4 motion; vec4 body; vec4 boundsMin; vec4 boundsMax; };
layout(set = 1, binding = 11, std430) buffer readonly DebrisDefinitionSSO
{
	vec4 debrisInfo;		// x the rest scale (r_debris_life / 60)  y rests this long or more are scaled  z capacity  w mesh instances
	DebrisDefinition debrisDefinitions[256];
	uint debrisMeshInstances[];
};

// DEBRIS_DEFINITION_SLOTS and DEBRIS_STEP_SECONDS (hw_debrisframe.h).
const int kDebrisDefinitionSlots = 256;
const float kDebrisStepSeconds = 1.0 / 35.0;

// How much of a pool piece is still drawn `age` seconds after its birth (its life `life`): 1 while it stays, 0 once it
// is gone, and between them over the fade at the end of its rest. The step's stay rule at the draw's time, so the
// "Debris time on the ground" slider (debrisInfo.x) shows at once, with the menu open.
float DebrisDrawFade(DebrisPiece piece, int defSlot, float age, float life)
{
	float restLife = debrisDefinitions[defSlot].physics.z;
	if (restLife <= 0.0)
		return (age <= life) ? 1.0 : 0.0;
	float restFade = debrisDefinitions[defSlot].physics.w;
	float scaledRest = (restLife >= debrisInfo.y) ? restLife * debrisInfo.x : restLife;
	float restStart = piece.velocity.w;
	if (restStart < 0.0 && age >= life)
		restStart = piece.spawn.a.w + life;
	if (restStart < 0.0)
		return 1.0;
	float overRest = uLevelTime.x - restStart - scaledRest;
	if (overRest <= 0.0)
		return 1.0;
	if (overRest >= restFade)
		return 0.0;
	return 1.0 - smoothstep(0.0, restFade, overRest);
}

void DrawPooledParticle(uint slot, int corner)
{
	DebrisPiece piece = debrisPieces[slot];
	GpuParticle part = piece.spawn;
	float life = part.b.w;
	float age = uLevelTime.x - part.a.w;
	int defSlot = clamp(int(part.d.x + 0.5), 0, kParticleDefinitionSlots - 1);
	if (piece.position.w < 0.5 || life <= 0.0 || age < 0.0 || defSlot >= kDebrisDefinitionSlots)
	{
		CollapseParticle();
		return;
	}
	float debrisFade = DebrisDrawFade(piece, defSlot, age, life);
	if (debrisFade <= 0.0)
	{
		CollapseParticle();
		return;
	}
	bool rests = debrisDefinitions[defSlot].physics.z > 0.0;
	float t = min(age / life, 1.0);

	// THE RAMPS: DrawDefinedParticle's.
	int keyCount = clamp(int(particleDefinitions[defSlot].motion.w + 0.5), 1, 8);
	int k0 = 0;
	int k1 = 0;
	float f = 0.0;
	if (keyCount > 1 && t > particleDefinitions[defSlot].key[0].x)
	{
		k0 = keyCount - 1;
		k1 = k0;
		for (int i = 1; i < keyCount; i++)
		{
			if (t < particleDefinitions[defSlot].key[i].x)
			{
				k0 = i - 1;
				k1 = i;
				float t0 = particleDefinitions[defSlot].key[k0].x;
				f = (t - t0) / (particleDefinitions[defSlot].key[k1].x - t0);
				break;
			}
		}
	}
	vec4 key0 = particleDefinitions[defSlot].key[k0];
	vec4 key1 = particleDefinitions[defSlot].key[k1];

	float rampSize = mix(key0.y, key1.y, f);
	float emissive = key0.w + (key1.w - key0.w) * f;
	vec3 color0 = ParticleKeyColor(defSlot, k0);
	vec3 rampColor = color0 + (ParticleKeyColor(defSlot, k1) - color0) * f;

	float cap = uGpuParticleParams.y;
	if (particleDefinitions[defSlot].motion.z > 0.0)
		cap = min(particleDefinitions[defSlot].motion.z, cap);
	float diameter = min(rampSize * part.d.y * uGpuParticleParams.x, cap);
	if (diameter <= 0.0)
	{
		CollapseParticle();
		return;
	}
	float halfSize = 0.5 * diameter;

	// THE MOTION: the pool's, between its last two steps.
	float stepBlend = clamp((uLevelTime.x - piece.previous.w) / kDebrisStepSeconds, 0.0, 1.0);
	vec3 pos = mix(piece.previous.xyz, piece.position.xyz, stepBlend);
	vec3 vel = piece.velocity.xyz;

	// THE SPIN: its turn about the view axis (the step keeps a billboard's turn about shader y).
	vec4 turnBefore = (dot(piece.previousTurn, piece.turn) < 0.0) ? -piece.previousTurn : piece.previousTurn;
	vec4 drawnTurn = mix(turnBefore, piece.turn, stepBlend);
	float spinAngle = 2.0 * atan(drawnTurn.y, drawnTurn.w);
	vec2 c = kParticleCorners[corner];
	vec2 offsetCorner = c;
	int orient = int(particleDefinitions[defSlot].shape.x + 0.5);
	if (orient != 1 && spinAngle != 0.0)
	{
		float ca = cos(spinAngle);
		float sa = sin(spinAngle);
		offsetCorner = vec2(c.x * ca - c.y * sa, c.x * sa + c.y * ca);
	}
	// [PARTICLECULL] E11: DrawDefinedParticle's cull, at the pool's own drawn centre, before the lights, flipbook and look.
	if (uGpuParticleParams2.w > 0.0 && ParticleOutsideView(pos, vel, halfSize, orient, particleDefinitions[defSlot].shape.y))
	{
		CollapseParticle();
		return;
	}
	vec4 eyePos = ParticleEyePosition(pos, vel, part.b.xyz, offsetCorner, halfSize, orient, particleDefinitions[defSlot].shape.y);

	// Flag 1's fade over the last 40% of life for a piece that never rests; a resting piece fades at the end of its rest.
	float fade = 1.0;
	if (!rests && (int(particleDefinitions[defSlot].look.w + 0.5) & 1) != 0)
		fade = 1.0 - smoothstep(0.6, 1.0, t);
	fade *= debrisFade;

	EmitParticle(eyePos, c, part.c.rgb * rampColor * (part.c.w * emissive * uGpuParticleParams.w * fade));
	vParticleFlipbook = ParticleFlipbookFrames(defSlot, age, t);

	// THE BODY AND THE LOOK: DrawDefinedParticle's.
	float alpha = clamp(key0.z + (key1.z - key0.z) * f, 0.0, 1.0) * fade;
	float lit = clamp(particleDefinitions[defSlot].look.x, 0.0, 1.0);
	vec3 bodyLight = vec3(1.0);
	int lookKind = int(ParticleLookShape(defSlot).x + 0.5);
	bool drawLook = lookKind != 0 && uGpuParticleParams2.z > 0.5;
	bool wantLightDirection = drawLook && (lookKind == kLookDust || lookKind == kLookSmoke) && uGpuParticleParams2.z > 1.5;
	vec4 lightDirectionSum = vec4(0.0);
	if (uGpuParticleParams2.y > 0.5 && alpha > 0.0 && lit > 0.0)
		bodyLight = mix(vec3(1.0), ParticleViewLight(pos, part.d.z, wantLightDirection, lightDirectionSum), lit);
	vParticleBody = vec4(part.c.rgb * rampColor * bodyLight, alpha);
	vParticleSoft = particleDefinitions[defSlot].look.y;

	vParticleLife = drawLook ? vec4(t, age, part.d.w, diameter) : vec4(0.0);
	vParticleLightDir = vec4(0.0);
	if (wantLightDirection && lightDirectionSum.w > 0.0)
	{
		float lookSpinAngle = (orient != 1) ? spinAngle : 0.0;
		vParticleLightDir = ParticleLightInQuad(lightDirectionSum, part.d.z, lit, pos, vel, part.b.xyz, lookSpinAngle, orient);
	}
}
// [DEBRISPOOL] end

void main()
{
#ifdef SUPPORTS_MULTIVIEW
	hwViewIndex = gl_ViewIndex;
#endif

	uint slot = aParticle.x | (aParticle.y << 16u);
	int corner = int(aParticle.z) % 6;
	// [DEBRISPOOL] A vertex of the debris pool's quads (aParticle.w = 1, DebrisPool::DrawBillboards): the piece in pool slot
	// `slot`. The ring's quads carry w = 0, so a ring vertex never comes here.
	if (aParticle.w != 0u)
	{
		DrawPooledParticle(slot, corner);
		return;
	}
	// [DEBRISPOOL] end
	GpuParticle part = gpuParticles[slot];

	float life = part.b.w;
	float age = uLevelTime.x - part.a.w;
	if (life <= 0.0 || age < 0.0 || age > life)
	{
		CollapseParticle();
		return;
	}

	if (part.e.x < -8.0)
		DrawLegacyParticle(part, corner, age, life);
	else
		DrawDefinedParticle(part, corner, age, life);
}
