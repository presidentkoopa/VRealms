+	PClassActor *cls = PClass::FindActor(FName(FStringf("RealmsWeapon%d", (int)pr.item).GetChars()));
+	if (cls == nullptr) cls = PClass::FindActor("RealmsHeld");
+	if (cls == nullptr) return;
